#!/usr/bin/env python3
"""vmvpn tray icon - GTK3 + AyatanaAppIndicator3 (SNI, works on GNOME/KDE)."""

import os
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator
from gi.repository import Gio, GLib, Gtk

import vmvpn_common as vc

try:
    gi.require_version("Notify", "0.7")
    from gi.repository import Notify

    _NOTIFY_OK = bool(Notify.init("VM VPN"))
except (ImportError, ValueError):
    _NOTIFY_OK = False

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
ICON_DIR = os.path.join(SCRIPT_DIR, "icons")
POLL_INTERVAL_SECONDS = 10

# Own full-colour icons shipped in gui/icons/ (installed next to this script):
# theme symbolic names are not reliable across desktops (shows "?").
ICON_CONNECTED = "vmvpn-connected"
ICON_ACQUIRING = "vmvpn-connecting"
ICON_DISCONNECTED = "vmvpn-disconnected"
ICON_DISABLED = "vmvpn-off"
ICON_NO_ROUTE = "vmvpn-error"


def _icon_path(name):
    return os.path.join(ICON_DIR, name + ".svg")


class TrayApp:
    def __init__(self):
        self.app = Gtk.Application(
            application_id="io.github.carrerfe.VmVpn.Tray",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )
        self.app.connect("startup", self._on_startup)
        self.app.connect("activate", self._on_activate)
        self.app.connect("shutdown", self._on_shutdown)

        self.status = None            # latest parsed `status --json` or None
        self.action = None            # None | "connect" | other action label
        self.action_running = False
        self.action_phase = ""        # latest '==> ' line while running
        self.flow = None
        self.last_failed = False
        self.poll_in_flight = False
        self.user_action_pending = False  # suppress "connection lost" once
        self.indicator = None
        self.menu = None
        self._dialogs = []
        self._menu_sig = None         # last built menu signature
        self._icon = None             # last icon name set on the indicator
        self._poll_log = vc.StatusPollLogger()

    # -- lifecycle ---------------------------------------------------------

    def _on_startup(self, app):
        self.indicator = AppIndicator.Indicator.new(
            "vmvpn",
            ICON_DISABLED,
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_icon_theme_path(ICON_DIR)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("VM VPN")
        app.hold()
        # Expose a "quit" application action so `vmvpn ui stop` can shut the
        # tray down over D-Bus (org.freedesktop.Application.ActivateAction).
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", self._quit)
        app.add_action(quit_action)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self._quit)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self._quit)
        self._refresh_ui()
        self._poll()
        GLib.timeout_add_seconds(POLL_INTERVAL_SECONDS, self._poll)

    def _on_activate(self, app):
        # Second-instance activation or explicit activation: refresh now.
        self._poll()

    def _on_shutdown(self, app):
        if self.flow is not None:
            self.flow.cancel()
        for dlg in self._dialogs:
            dlg.destroy()

    def _quit(self, *_args):
        self.app.quit()
        return GLib.SOURCE_REMOVE

    # -- status accessors ----------------------------------------------------

    def _vm(self):
        return (self.status or {}).get("vm") or {}

    def _vpn(self):
        return (self.status or {}).get("vpn") or {}

    def _cfg(self):
        return (self.status or {}).get("config") or {}

    def _vm_running(self):
        return self._vm().get("status") == "Running"

    def _connected(self):
        return self._vpn().get("state") == "connected"

    def _config_valid(self):
        cfg = self._cfg()
        return bool(cfg.get("exists") and cfg.get("valid"))

    def _status_busy(self):
        """True when another vmvpn process holds the operation lock."""
        return bool((self.status or {}).get("busy"))

    def _busy(self):
        """True while our own action or another process's operation runs."""
        return self.action_running or self._status_busy()

    # -- polling -------------------------------------------------------------

    def _poll(self, *_args):
        if self.poll_in_flight:
            return GLib.SOURCE_CONTINUE
        self.poll_in_flight = True
        vc.run_cli(["status", "--json"], self._on_polled, log=False)
        return GLib.SOURCE_CONTINUE

    def _on_polled(self, rc, stdout, stderr):
        self.poll_in_flight = False
        prev_status = self.status
        prev_vpn_state = self._vpn().get("state")
        prev_busy = bool((prev_status or {}).get("busy"))
        self.status = vc.parse_status(stdout) if rc == vc.EXIT_OK else None
        new_busy = self._status_busy()
        self._poll_log.report(self.status is not None, stderr)

        if self.action_running:
            return  # keep the data, but don't disturb the busy UI

        new_vpn_state = self._vpn().get("state")
        if (
            prev_vpn_state == "connected"
            and new_vpn_state == "disconnected"
            and not self.user_action_pending
            and not prev_busy
            and not new_busy
        ):
            self._notify(
                "VPN connection lost",
                "The VPN connection dropped.",
                ICON_DISCONNECTED,
            )
        self.user_action_pending = False
        self._refresh_ui()

    # -- UI ------------------------------------------------------------------

    def _icon_name(self):
        if self._busy():
            return ICON_ACQUIRING
        if self.last_failed or self.status is None:
            return ICON_NO_ROUTE
        if self._connected():
            return ICON_CONNECTED
        if self._config_valid() and self._vm_running():
            return ICON_DISCONNECTED
        return ICON_DISABLED

    def _header_text(self):
        phase = getattr(self, "action_phase", "") or ""
        if self.action == "connect":
            return phase or "Connecting…"
        if self._busy():
            return phase or "Working…"
        if self.status is None:
            return "Status unavailable"
        if not self._config_valid():
            return "Set up VM VPN…"
        if not self._vm().get("exists") or not self._vm_running():
            return "VM stopped"
        if self._connected():
            gateway = self._cfg().get("gateway")
            if gateway:
                return "Connected — %s" % gateway
            return "Connected"
        return "Disconnected"

    def _refresh_ui(self):
        icon = self._icon_name()
        if icon != self._icon:
            self._icon = icon
            self.indicator.set_icon_full(icon, "VM VPN")
        self._rebuild_menu()

    @staticmethod
    def _sep():
        item = Gtk.SeparatorMenuItem()
        item.show()
        return item

    def _window_path(self):
        # The CLI owns launching the window (vmvpn ui <page>); this only
        # reports whether a UI is available for menu sensitivity.
        return vc.find_cli()

    def _menu_signature(self):
        """Tuple describing the menu model; rebuild only when it changes."""
        busy = self._busy()
        connected = self._connected()
        return (
            self._header_text(),
            "Disconnect" if connected else "Connect",
            not busy and (connected or self._config_valid()),
            not busy and connected,                        # firefox
            self._window_path() is not None,               # status/settings
            (self.status or {}).get("version"),            # about comments
        )

    def _rebuild_menu(self):
        sig = self._menu_signature()
        if sig == self._menu_sig:
            return
        self._menu_sig = sig

        menu = Gtk.Menu()
        busy = self._busy()
        connected = self._connected()

        configured = self._config_valid()

        status_item = Gtk.MenuItem(label=self._header_text())
        status_item.set_sensitive(self._window_path() is not None)
        status_item.connect(
            "activate",
            self._on_open_status if configured else self._on_open_setup,
        )
        status_item.show()
        menu.append(status_item)

        menu.append(self._sep())

        if connected:
            conn_item = Gtk.MenuItem(label="Disconnect")
            conn_item.connect("activate", self._on_disconnect)
            conn_item.set_sensitive(not busy)
        else:
            conn_item = Gtk.MenuItem(label="Connect")
            conn_item.connect(
                "activate",
                self._on_connect if configured else self._on_open_setup,
            )
            conn_item.set_sensitive(
                not busy and (configured or self._window_path() is not None)
            )
        conn_item.show()
        menu.append(conn_item)

        firefox_item = Gtk.MenuItem(label="Launch VPN Firefox")
        firefox_item.set_sensitive(not busy and connected)
        firefox_item.connect("activate", self._on_firefox)
        firefox_item.show()
        menu.append(firefox_item)

        menu.append(self._sep())

        settings_item = Gtk.MenuItem(label="Settings…")
        settings_item.set_sensitive(self._window_path() is not None)
        settings_item.connect("activate", self._on_open_settings)
        settings_item.show()
        menu.append(settings_item)

        about_item = Gtk.MenuItem(label="About VM VPN")
        about_item.connect("activate", self._on_about)
        about_item.show()
        menu.append(about_item)

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self._on_quit_item)
        quit_item.show()
        menu.append(quit_item)

        menu.show_all()
        # Detach the previous secondary-activate target before its menu is
        # torn down, or libayatana emits a gtk_widget_get_parent critical.
        self.indicator.set_secondary_activate_target(None)
        self.indicator.set_menu(menu)
        self.indicator.set_secondary_activate_target(conn_item)
        self.menu = menu

    # -- actions ---------------------------------------------------------------

    def _connect(self, *_args):
        if self._busy():
            return
        self.user_action_pending = True
        self.action_running = True
        self.action = "connect"
        self.action_phase = ""
        if not self._vm().get("exists"):
            self._notify(
                "Creating the VM",
                "The first connection takes 5–15 minutes.",
                ICON_ACQUIRING,
            )
        self._refresh_ui()
        self.flow = vc.ConnectFlow(
            self._ask_password,
            self._ask_trust,
            self._connect_done,
            on_warning=self._on_keyring_warning,
            on_line=self._on_action_line,
        )
        self.flow.start()

    def _on_action_line(self, line):
        if line.startswith("==> "):
            self.action_phase = line[4:]
            self._refresh_ui()

    def _on_keyring_warning(self, message):
        self._notify(
            "Could not save password to keyring", message, ICON_NO_ROUTE
        )

    def _connect_done(self, rc, stdout, stderr):
        self.flow = None
        self.action_running = False
        self.action = None
        self.action_phase = ""
        if rc == vc.EXIT_OK:
            self.last_failed = False
            self._notify("VM VPN", "VPN connected.", ICON_CONNECTED)
        else:
            if rc != vc.EXIT_PASSWORD_REQUIRED:
                # rc 4 means the user cancelled the password dialog: stay silent
                self.last_failed = True
                self._notify_failure("Connect", rc, stdout, stderr)
        self._refresh_ui()
        self._poll()

    def _on_connect(self, *_args):
        self._connect()

    def _on_disconnect(self, *_args):
        self._run_action("disconnect", ["vpn-disconnect"])

    def _on_firefox(self, *_args):
        self._run_action("firefox", ["firefox"])

    def _on_open_status(self, *_args):
        self._open_window("status")

    def _on_open_settings(self, *_args):
        self._open_window("settings")

    def _on_open_setup(self, *_args):
        self._open_window("setup")

    def _open_window(self, page):
        # Single launch path: the CLI starts/presents the window.
        vc.open_ui(page)

    def _on_about(self, *_args):
        dialog = Gtk.AboutDialog()
        dialog.set_program_name("VM VPN")
        dialog.set_version(vc.VERSION)
        comments = vc.release_line()
        cli_version = (self.status or {}).get("version")
        if cli_version and cli_version != vc.VERSION:
            comments += "\nCLI reports %s" % cli_version
        dialog.set_comments(comments)
        dialog.set_website("https://github.com/carrerfe/vm-vpn")
        dialog.set_license_type(Gtk.License.MIT_X11)
        dialog.connect("response", lambda d, *_: d.destroy())
        dialog.show()

    def _run_action(self, action, args, stream=False):
        if self._busy():
            return
        self.user_action_pending = True
        self.action_running = True
        self.action = action
        self.action_phase = ""
        self._refresh_ui()

        def done(rc, stdout, stderr):
            self.action_running = False
            self.action = None
            self.action_phase = ""
            if rc == vc.EXIT_OK:
                self.last_failed = False
                if action == "disconnect":
                    self._notify("VM VPN", "VPN disconnected.", ICON_DISCONNECTED)
            else:
                self.last_failed = True
                self._notify_failure(action, rc, stdout, stderr)
            self._refresh_ui()
            self._poll()

        vc.run_cli(
            args, done, on_line=self._on_action_line if stream else None
        )

    # -- dialogs -------------------------------------------------------------------

    def _ask_password(self, error_message, cb):
        cfg = self._cfg()
        username = cfg.get("username")
        gateway = cfg.get("gateway")
        if username and gateway:
            prompt = "VPN password for %s@%s" % (username, gateway)
        else:
            prompt = "VPN password"

        dialog = Gtk.Dialog(title="VM VPN")
        dialog.add_buttons(
            "_Cancel", Gtk.ResponseType.CANCEL,
            "_Connect", Gtk.ResponseType.OK,
        )
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)

        label = Gtk.Label(label=prompt)
        label.set_xalign(0.0)
        box.pack_start(label, False, False, 0)

        if error_message:
            err_label = Gtk.Label()
            err_label.set_markup(
                '<span foreground="red">%s</span>'
                % GLib.markup_escape_text(error_message)
            )
            err_label.set_xalign(0.0)
            box.pack_start(err_label, False, False, 0)

        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_activates_default(True)
        box.pack_start(entry, False, False, 0)

        remember = Gtk.CheckButton(label="Remember in GNOME keyring")
        box.pack_start(remember, False, False, 0)

        self._dialogs.append(dialog)

        def on_response(dlg, response):
            if dlg in self._dialogs:
                self._dialogs.remove(dlg)
            if response == Gtk.ResponseType.OK:
                password = entry.get_text()
                cb(password if password else None, remember.get_active())
            else:
                cb(None, False)
            dlg.destroy()

        dialog.connect("response", on_response)
        dialog.show_all()
        dialog.present()

    def _ask_trust(self, new_fp, saved_fp, cb):
        if saved_fp:
            message_type = Gtk.MessageType.WARNING
            text = "VPN server certificate has CHANGED"
            secondary = (
                "Saved fingerprint:\n<tt>%s</tt>\n\nNew fingerprint:\n"
                "<tt>%s</tt>\n\nThis could indicate a man-in-the-middle "
                "attack or a legitimate certificate update.\n"
                "Trust the new certificate?"
                % (
                    GLib.markup_escape_text(saved_fp),
                    GLib.markup_escape_text(new_fp),
                )
            )
        else:
            message_type = Gtk.MessageType.QUESTION
            text = "New VPN server certificate"
            secondary = (
                "Fingerprint (SHA1):\n<tt>%s</tt>\n\n"
                "Trust this certificate and save the fingerprint?"
                % GLib.markup_escape_text(new_fp)
            )

        dialog = Gtk.MessageDialog(
            transient_for=None,
            flags=0,
            message_type=message_type,
            buttons=Gtk.ButtonsType.NONE,
            text=text,
        )
        dialog.format_secondary_markup(secondary)
        dialog.add_buttons(
            "_Cancel", Gtk.ResponseType.CANCEL,
            "_Trust", Gtk.ResponseType.OK,
        )
        self._dialogs.append(dialog)

        def on_response(dlg, response):
            if dlg in self._dialogs:
                self._dialogs.remove(dlg)
            cb(response == Gtk.ResponseType.OK)
            dlg.destroy()

        dialog.connect("response", on_response)
        dialog.show_all()
        dialog.present()

    # -- notifications -------------------------------------------------------------

    def _notify(self, summary, body="", icon=ICON_CONNECTED):
        icon_ref = icon if "/" in icon else _icon_path(icon)
        if _NOTIFY_OK:
            try:
                notification = Notify.Notification.new(summary, body, icon_ref)
                notification.show()
                return
            except Exception:
                pass
        try:
            subprocess.Popen(
                ["notify-send", summary, body],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            pass  # silent fallback

    def _notify_failure(self, action, rc, stdout, stderr):
        if rc == vc.EXIT_BUSY:
            self._notify(
                "Another vmvpn operation is in progress", "", ICON_NO_ROUTE
            )
            return
        if rc == vc.EXIT_LOGIN_FAILED:
            self._notify(
                "VPN login failed", "Check your credentials.", ICON_NO_ROUTE
            )
            return
        if rc == vc.EXIT_CERT_UNTRUSTED:
            self._notify(
                "VPN certificate rejected",
                "The server certificate was not trusted.",
                ICON_NO_ROUTE,
            )
            return
        if rc == vc.EXIT_CONFIG_INVALID:
            path = self._cfg().get("path") or os.environ.get(
                "VPN_CONFIG", "vpn-config.json"
            )
            self._notify(
                "VPN config missing or invalid: %s" % path,
                "",
                ICON_NO_ROUTE,
            )
            return
        detail = ""
        for line in reversed((stderr or "").splitlines()):
            if line.strip():
                detail = line.strip()
                break
        if not detail:
            for line in reversed((stdout or "").splitlines()):
                if line.strip():
                    detail = line.strip()
                    break
        self._notify("%s failed" % action, detail, ICON_NO_ROUTE)

    def _on_quit_item(self, *_args):
        self._quit()


_USAGE = """vmvpn-tray — internal component of VM VPN (tray icon).
Do not run it directly; manage the app through the CLI:

  vmvpn ui               open the app
  vmvpn ui tray on|off   show/hide the tray icon
  vmvpn ui stop          quit the app

Options:
  -h, --help      show this message
  -V, --version   print the version
"""


def main():
    args = sys.argv[1:]
    if any(a in ("--help", "-h") for a in args):
        print(_USAGE, end="")
        return 0
    if any(a in ("--version", "-V") for a in args):
        print("vmvpn-tray %s" % vc.VERSION)
        return 0
    if args:
        sys.stderr.write(
            "vmvpn-tray: unknown option: %s\n" % args[0]
            + "vmvpn-tray is an internal component of VM VPN —"
            " use 'vmvpn ui' instead.\n"
        )
        return 2
    app = TrayApp()
    return app.app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
