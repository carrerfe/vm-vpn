def _dep_fix_command():
    """Package-install command for the detected distro (for copy buttons)."""
    try:
        info = {}
        with open("/etc/os-release", encoding="utf-8") as f:
            for line in f:
                k, _, v = line.partition("=")
                info[k.strip()] = v.strip().strip('"')
        ids = {info.get("ID", "")} | set(
            info.get("ID_LIKE", "").split()
        )
    except OSError:
        ids = set()
    if "fedora" in ids:
        return (
            "sudo dnf install qemu-system-x86 qemu-img edk2-ovmf jq "
            "openssh-clients curl python3-gobject gtk3 gtk4 "
            "libadwaita libayatana-appindicator-gtk3 libnotify "
            "libsecret firefox"
        )
    if ids & {"debian", "ubuntu"}:
        import platform

        machine = platform.machine()
        if machine == "aarch64":
            qemu = "qemu-system-arm qemu-efi-aarch64"
        else:
            qemu = "qemu-system-x86 ovmf"
        return (
            "sudo apt install %s qemu-utils jq openssh-client curl "
            "python3-gi gir1.2-gtk-3.0 gir1.2-gtk-4.0 gir1.2-adw-1 "
            "gir1.2-ayatanaappindicator3-0.1 gir1.2-notify-0.7 "
            "libsecret-tools firefox" % qemu
        )
    return (
        "Install Lima, QEMU, jq, Python GObject introspection and the "
        "GTK/libadwaita bindings with your package manager"
    )


class _CheckRow(Adw.ActionRow):
    """One system-check row: icon + explanation + optional fix copy."""

    def __init__(self, title, required=True, fix=None):
        super().__init__(title=title)
        self.required = required
        self.fix = fix
        self.icon = Gtk.Image(valign=Gtk.Align.CENTER)
        self.add_suffix(self.icon)
        self.copy_btn = Gtk.Button(
            icon_name="edit-copy-symbolic",
            valign=Gtk.Align.CENTER,
            tooltip_text="Copy the fix command",
        )
        self.copy_btn.add_css_class("flat")
        self.copy_btn.set_visible(False)
        self.copy_btn.connect("clicked", self._on_copy)
        self.add_suffix(self.copy_btn)
        self.ok = None

    def _on_copy(self, *_args):
        if self.fix:
            self.get_clipboard().set_text(self.fix)
            self.set_subtitle("Fix: %s  (copied)" % self.fix)

    def set_state(self, ok, detail=""):
        self.ok = ok
        self.icon.set_from_icon_name(
            "emblem-ok-symbolic" if ok else "dialog-warning-symbolic"
        )
        if detail:
            self.set_subtitle(detail)
        elif self.fix and not ok:
            self.set_subtitle("Fix: %s" % self.fix)
        self.copy_btn.set_visible(bool(self.fix) and not ok)


class SetupAssistant(Adw.Window):
    """Four-page first-run wizard (Adw.NavigationView)."""

    def __init__(self, win):
        super().__init__(
            transient_for=win,
            modal=True,
            title="Set up VM VPN",
            default_width=600,
            default_height=720,
        )
        self.win = win
        self.password = None          # kept in memory for "Connect now"
        self._pw_save_failed = False
        self._vm_proc = None
        self._vm_done_ok = False
        self.nav = Adw.NavigationView()
        self.set_content(self.nav)
        self.nav.push(self._page_welcome())

    # -- helpers ---------------------------------------------------------------

    @staticmethod
    def _page(title, body, actions=None):
        """Wrap body in a NavigationPage: header, scrolled clamp, and a
        persistent bottom bar for the page actions."""
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar.add_top_bar(header)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        clamp = Adw.Clamp(maximum_size=560)
        clamp.set_child(body)
        scroll.set_child(clamp)
        toolbar.set_content(scroll)
        if actions is not None:
            toolbar.add_bottom_bar(actions)
        page = Adw.NavigationPage(child=toolbar)
        page.set_title(title)
        return page

    @staticmethod
    def _actions_box(*widgets):
        """Bottom action bar: right-aligned buttons with margins."""
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_halign(Gtk.Align.END)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(12)
        box.set_margin_end(12)
        for w in widgets:
            box.append(w)
        return box

    def _close(self, *_args):
        self.close()

    # -- page 1: welcome + system check ----------------------------------------

    def _page_welcome(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(12)
        box.set_margin_bottom(12)

        intro = Gtk.Label(
            xalign=0.0,
            wrap=True,
            label=(
                "VM VPN runs your organisation's VPN client inside a small "
                "virtual machine, so the host stays clean. This assistant "
                "checks the system, asks for your VPN account, creates the "
                "VM once, and connects."
            ),
        )
        intro.add_css_class("dim-label")
        box.append(intro)

        self.check_group = Adw.PreferencesGroup(title="System check")
        box.append(self.check_group)

        self.check_rows = []

        again = Gtk.Button(label="Check again")
        again.connect("clicked", lambda *_: self._populate_checks())
        self.welcome_next = Gtk.Button(label="Next")
        self.welcome_next.add_css_class("suggested-action")
        self.welcome_next.connect(
            "clicked", lambda *_: self.nav.push(self._page_account())
        )
        actions = self._actions_box(again, self.welcome_next)

        self._populate_checks()
        return self._page("Welcome", box, actions)

    def _populate_checks(self):
        for row in self.check_rows:
            self.check_group.remove(row)
        self.check_rows = []

        import platform
        import shutil as _shutil
        import stat as _stat

        machine = platform.machine()
        qemu_bin = (
            "qemu-system-aarch64" if machine == "aarch64"
            else "qemu-system-x86_64"
        )
        fix = _dep_fix_command()
        kvm_ok = os.access("/dev/kvm", os.R_OK | os.W_OK)
        try:
            free = _shutil.disk_usage(
                os.path.expanduser("~")
            ).free
            disk_ok = free >= 5 * 1024**3
            disk_detail = "%s free" % GLib.format_size(free)
        except OSError:
            disk_ok = True
            disk_detail = ""

        checks = [
            ("Lima (limactl)", _shutil.which("limactl") is not None, True,
             fix, "Re-run the installer; it installs Lima for you."),
            ("QEMU (%s)" % qemu_bin, _shutil.which(qemu_bin) is not None,
             True, fix, "Install the QEMU package."),
            ("qemu-img", _shutil.which("qemu-img") is not None, True,
             fix, "Install qemu-utils / qemu-img."),
            ("/dev/kvm access", kvm_ok, True,
             'sudo usermod -aG kvm "$USER"',
             "Required for fast virtualization. After the fix, log out "
             "and back in."),
            ("jq", _shutil.which("jq") is not None, True, fix, ""),
            ("Disk space (≥ 5 GiB)", disk_ok, True, None, disk_detail),
            ("GNOME Keyring (secret-tool)",
             vc.secret_tool_available(), False, fix,
             "Optional — stores your VPN password."),
            ("Firefox", _shutil.which("firefox") is not None, False,
             "sudo apt install firefox",
             "Optional — needed for the VPN browser profile."),
        ]
        for title, ok, required, fix, detail in checks:
            row = _CheckRow(title, required=required, fix=fix)
            row.set_state(ok, detail)
            self.check_rows.append(row)
            self.check_group.add(row)
        self._update_welcome_next()

    def _update_welcome_next(self):
        missing = [r for r in self.check_rows if r.required and r.ok is False]
        self.welcome_next.set_sensitive(not missing)

    # -- page 2: VPN account ----------------------------------------------------

    def _page_account(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(12)
        box.set_margin_bottom(12)

        group = Adw.PreferencesGroup(
            title="VPN account",
            description="Enter the details your organisation gave you.",
        )
        self.acc_server = Adw.EntryRow(title="Server (e.g. vpn.example.com)")
        self.acc_port = Adw.SpinRow.new_with_range(1, 65535, 1)
        self.acc_port.set_title("Port")
        self.acc_port.set_value(443)
        self.acc_user = Adw.EntryRow(title="Username")
        self.acc_pass = Adw.PasswordEntryRow(title="Password")
        group.add(self.acc_server)
        group.add(self.acc_port)
        group.add(self.acc_user)
        group.add(self.acc_pass)
        self.acc_remember = Adw.SwitchRow(title="Remember password")
        self.acc_remember.set_active(True)
        if vc.secret_tool_available():
            self.acc_remember.set_subtitle("Stored in GNOME Keyring")
        else:
            self.acc_remember.set_subtitle(
                "Keyring unavailable — saved in the config file"
            )
        group.add(self.acc_remember)
        box.append(group)

        self.acc_error = Gtk.Label(xalign=0.0, wrap=True)
        self.acc_error.add_css_class("error")
        self.acc_error.set_visible(False)
        box.append(self.acc_error)

        # Prefill from an existing config when re-running. Example
        # placeholder values mean "unset" — leave the field empty.
        cfg = vc.load_config(vc.config_path())
        if cfg.get("gateway") and not vc.is_placeholder(cfg["gateway"]):
            self.acc_server.set_text(str(cfg["gateway"]))
        if cfg.get("port"):
            try:
                self.acc_port.set_value(float(cfg["port"]))
            except (TypeError, ValueError):
                pass
        if cfg.get("username") and not vc.is_placeholder(cfg["username"]):
            self.acc_user.set_text(str(cfg["username"]))

        next_btn = Gtk.Button(label="Next")
        next_btn.add_css_class("suggested-action")
        next_btn.connect("clicked", self._on_account_next)
        actions = self._actions_box(next_btn)
        return self._page("VPN account", box, actions)

    def _on_account_next(self, *_args):
        host, port = vc.parse_host_port(
            self.acc_server.get_text(), int(self.acc_port.get_value())
        )
        if host is None:
            self.acc_error.set_label("Enter a valid server name.")
            self.acc_error.set_visible(True)
            return
        username = self.acc_user.get_text().strip()
        if not username:
            self.acc_error.set_label("Enter your username.")
            self.acc_error.set_visible(True)
            return
        self.acc_error.set_visible(False)

        # Merge into the existing config, preserving unknown keys.
        path = vc.config_path()
        cfg = vc.load_config(path)
        cfg["gateway"] = host
        cfg["port"] = int(port)
        cfg["username"] = username
        socks = cfg.get("socks_proxy")
        if not isinstance(socks, dict):
            socks = {}
        socks.update(
            {"enabled": True, "port": vc.find_free_port(1080),
             "auto_start": True, "auto_stop": True}
        )
        cfg["socks_proxy"] = socks
        http = cfg.get("http_proxy")
        if not isinstance(http, dict):
            http = {}
        http["enabled"] = False
        cfg["http_proxy"] = http

        password = self.acc_pass.get_text()
        self.password = password or None
        if password:
            if self.acc_remember.get_active():
                cfg.pop("password", None)  # keyring instead
            else:
                cfg["password"] = password
        try:
            vc.save_config(path, cfg)
        except OSError as exc:
            self.acc_error.set_label("Could not write config: %s" % exc)
            self.acc_error.set_visible(True)
            return

        if (
            password
            and self.acc_remember.get_active()
            and vc.secret_tool_available()
            and not self._pw_save_failed
        ):
            self._save_password_then_next(path)
        else:
            self.nav.push(self._page_vm())

    def _save_password_then_next(self, path):
        self.acc_error.set_visible(False)

        def done(rc, _out, err):
            if rc == vc.EXIT_OK:
                self.nav.push(self._page_vm())
            else:
                self.acc_error.set_label(
                    "Could not save the password to the keyring: %s. "
                    "Press Next again to continue without saving it — it "
                    "will only be used for this session's connect."
                    % (_last_line(err) or "exit %s" % rc)
                )
                self.acc_error.set_visible(True)
                self._pw_save_failed = True

        vc.run_cli(
            ["password-set", "--stdin"], done,
            stdin_text=self.acc_pass.get_text() + "\n",
        )

    # -- page 3: prepare the VM --------------------------------------------------

    def _page_vm(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(12)
        box.set_margin_bottom(12)

        group = Adw.PreferencesGroup(title="Virtual machine")
        self.vm_status_row = Adw.ActionRow(title="Status")
        group.add(self.vm_status_row)
