        )
        folder_btn.connect("clicked", self._open_folder)
        top.append(folder_btn)
        self.append(top)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.text_view = Gtk.TextView()
        self.text_view.set_monospace(True)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.buffer = self.text_view.get_buffer()
        scrolled.set_child(self.text_view)
        self.append(scrolled)

        self._sources_sig = None
        self._monitor = None
        self._timer = 0
        self._vm_dir = None

    # -- source list -----------------------------------------------------------

    @staticmethod
    def _factory_setup(_factory, item):
        label = Gtk.Label(xalign=0.0)
        label.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        item.set_child(label)

    @staticmethod
    def _factory_bind(_factory, item):
        src = item.get_item()
        label = item.get_child()
        label.set_label(src.name)
        label.set_sensitive(src.enabled)

    def _build_sources(self, status):
        st = status or {}
        vm = st.get("vm") or {}
        vm_running = vm.get("status") == "Running"
        vm_dir = vm.get("dir") or ""
        sources = [
            LogSource("GUI activity", "file", vc.gui_log_path()),
        ]
        if vm_dir:
            for label, fname in (
                ("Lima host agent", "ha.stderr.log"),
                ("Lima host agent (stdout)", "ha.stdout.log"),
                ("Lima serial log", "serial.log"),
                ("Lima serial log (verbose)", "serialv.log"),
            ):
                path = os.path.join(vm_dir, fname)
                if os.path.exists(path):
                    sources.append(LogSource(label, "file", path))
        for label, ref in (
            ("Guest journal", "journal"),
            ("Squid", "squid"),
            ("FortiClient", "forticlient"),
        ):
            sources.append(LogSource(label, "guest", ref, enabled=vm_running))
        return sources

    def update_status(self, status, _busy):
        sources = self._build_sources(status)
        sig = tuple((s.name, s.kind, s.ref, s.enabled) for s in sources)
        if sig == self._sources_sig:
            return
        prev_ref = None
        cur = self._current_source()
        if cur is not None:
            prev_ref = (cur.kind, cur.ref)
        self._sources_sig = sig
        self.model.remove_all()
        selected = 0
        for i, src in enumerate(sources):
            self.model.append(src)
            if (src.kind, src.ref) == prev_ref:
                selected = i
        self.dropdown.set_selected(selected)
        # set_selected does not emit notify::selected if index unchanged
        self._on_selected()

    def _current_source(self):
        idx = self.dropdown.get_selected()
        if idx == Gtk.INVALID_LIST_POSITION:
            return None
        return self.model.get_item(idx)

    def _on_selected(self, *_args):
        self._arm_auto()
        self.reload()

    # -- loading --------------------------------------------------------------

    def _set_text(self, text):
        self.buffer.set_text(text)
        GLib.idle_add(self._scroll_to_end)

    def _scroll_to_end(self):
        end = self.buffer.get_end_iter()
        self.text_view.scroll_to_iter(end, 0.0, True, 0.0, 1.0)
        return GLib.SOURCE_REMOVE

    def reload(self):
        src = self._current_source()
        if src is None:
            return
        if src.kind == "guest":
            if not src.enabled:
                self._set_text("VM is not running.\n")
                return
            self._set_text("Loading %s…\n" % src.name)

            def done(rc, stdout, stderr):
                if self._current_source() is not src:
                    return
                if rc == vc.EXIT_OK:
                    self._set_text(stdout or "(no output)\n")
                else:
                    detail = _last_line(stderr) or _last_line(stdout)
                    vc.log_line(
                        "logs %s failed (exit %s): %s"
                        % (src.ref, rc, detail or "no output")
                    )
                    self._set_text(
                        "logs %s failed (exit %s):\n%s"
                        % (src.ref, rc, stderr or stdout)
                    )

            vc.run_cli(
                ["logs", src.ref, "-n", str(LOG_MAX_LINES)], done, log=False
            )
        else:
            self._load_file_tail(src.ref)

    def _load_file_tail(self, path):
        gfile = Gio.File.new_for_path(path)

        def on_info(f, res):
            try:
                info = f.query_info_finish(res)
                size = info.get_size()
            except GLib.Error as exc:
                self._set_text("Cannot read %s:\n%s\n" % (path, exc.message))
                return
            f.read_async(
                GLib.PRIORITY_DEFAULT,
                None,
                lambda f2, r2: self._on_stream(f2, r2, path, size),
            )

        gfile.query_info_async(
            "standard::size",
            Gio.FileQueryInfoFlags.NONE,
            GLib.PRIORITY_DEFAULT,
            None,
            on_info,
        )

    def _on_stream(self, gfile, res, path, size):
        try:
            stream = gfile.read_finish(res)
        except GLib.Error as exc:
            self._set_text("Cannot read %s:\n%s\n" % (path, exc.message))
            return
        start = max(0, size - FILE_TAIL_BYTES)
        if start:
            stream.seek(start, GLib.SeekType.SET, None)
        chunks = []

        def read_more():
            stream.read_bytes_async(
                65536, GLib.PRIORITY_DEFAULT, None, on_chunk
            )

        def on_chunk(s, r):
            try:
                data = s.read_bytes_finish(r).get_data()
            except GLib.Error:
                data = None
            if data:
                chunks.append(data)
                read_more()
                return
            text = b"".join(chunks).decode("utf-8", "replace")
            lines = text.splitlines()[-LOG_MAX_LINES:]
            out = "\n".join(lines)
            if start:
                out = "… (last %d lines)\n%s" % (len(lines), out)
            self._set_text(out + "\n")
            stream.close(None)

        read_more()

    # -- auto refresh ----------------------------------------------------------

    def _disarm_auto(self):
        if self._monitor is not None:
            self._monitor.cancel()
            self._monitor = None
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = 0

    def _arm_auto(self):
        self._disarm_auto()
        if not self.auto_btn.get_active():
            return
        src = self._current_source()
        if src is None:
            return
        if src.kind == "file":
            try:
                gfile = Gio.File.new_for_path(src.ref)
                self._monitor = gfile.monitor_file(
                    Gio.FileMonitorFlags.NONE, None
                )
                self._monitor.connect("changed", lambda *_: self.reload())
            except GLib.Error:
                self._timer = GLib.timeout_add_seconds(
                    FILE_WATCH_SECONDS, self._auto_tick
                )
        else:
            self._timer = GLib.timeout_add_seconds(
                GUEST_LOG_SECONDS, self._auto_tick
            )

    def _auto_tick(self):
        src = self._current_source()
        if src is not None and (src.kind == "file" or src.enabled):
            self.reload()
        return GLib.SOURCE_CONTINUE

    # -- actions -----------------------------------------------------------------

    def _copy_all(self, *_args):
        text = self.buffer.get_text(
            self.buffer.get_start_iter(), self.buffer.get_end_iter(), False
        )
        self.get_clipboard().set_text(text)
        self.win.toast("Log copied to clipboard")

    def _open_folder(self, *_args):
        src = self._current_source()
        target = None
        if src is not None:
            if src.kind == "file":
                target = os.path.dirname(src.ref)
            else:
                vm = (self.win.status or {}).get("vm") or {}
                target = vm.get("dir")
        if not target:
            return
        launcher = Gtk.FileLauncher.new(Gio.File.new_for_path(target))
        launcher.launch(self.get_root(), None, None)


