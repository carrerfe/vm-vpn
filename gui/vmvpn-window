    @staticmethod
    def _host_mem_mib():
        try:
            with open("/proc/meminfo", encoding="ascii") as f:
                for line in f:
                    if line.startswith("MemTotal:"):
                        return max(1024, int(line.split()[1]) // 1024)
        except (OSError, ValueError):
            pass
        return 65536

    # -- load/save ---------------------------------------------------------------

    def _resolve_path(self, status):
        cfg = ((status or {}).get("config") or {})
        if cfg.get("path"):
            return cfg["path"]
        env_path = os.environ.get("VPN_CONFIG")
        if env_path:
            return env_path
        cli = vc.find_cli()
        if cli:
            return os.path.join(os.path.dirname(cli), "vpn-config.json")
        return os.path.join(SCRIPT_DIR, "..", "vpn-config.json")

    def update_status(self, status, _busy):
        if self.cfg is None:
            self.load(self._resolve_path(status))
        cfg = (status or {}).get("config") or {}
        source = cfg.get("password_source") or "none"
        labels = {
            "keyring": "Keyring",
            "config": "Config file (plaintext)",
            "none": "Not stored",
        }
        self.pw_source_row.set_subtitle(labels.get(source, source))
        for cls in ("warning",):
            self.pw_source_row.remove_css_class(cls)
        if source == "config":
            self.pw_source_row.add_css_class("warning")
        self.pw_move.set_visible(source == "config")
        fp = ((status or {}).get("cert") or {}).get("fingerprint")
        self.cert_row.set_subtitle(str(fp) if fp else "None saved")

        vm = (status or {}).get("vm") or {}
        busy = bool(_busy)
        self.abort_row.set_sensitive(busy)
        pending = bool((status or {}).get("vm_pending_restart"))
        self.vm_apply_row.set_subtitle(
            "Restart required to apply" if pending else ""
        )
        # Disk cannot shrink: the lower bound follows the live instance size.
        disk_bytes = vm.get("disk_bytes")
        if isinstance(disk_bytes, (int, float)) and disk_bytes > 0:
            disk_gib = max(5, int(round(disk_bytes / 1073741824)))
            self._filling = True
            self.vm_disk_row.get_adjustment().set_lower(disk_gib)
            self._filling = False
        # Unmanaged rows mirror the live instance until the user edits them.
        if not self._dirty:
            self._fill_vm_rows()

    def load(self, path):
        self.path = path
        self.cfg = vc.load_config(path)
        self._fill()

    def _fill(self):
        self._filling = True
        cfg = self.cfg or {}
        gateway = cfg.get("gateway") or ""
        username = cfg.get("username") or ""
        # Example placeholder values mean "unset".
        if vc.is_placeholder(gateway):
            gateway = ""
        if vc.is_placeholder(username):
            username = ""
        self.gw_row.set_text(str(gateway))
        self.port_row.set_value(float(cfg.get("port") or 443))
        self.user_row.set_text(str(username))
        socks = cfg.get("socks_proxy") or {}
        http = cfg.get("http_proxy") or {}
        self.socks_enabled.set_active(bool(socks.get("enabled", True)))
        self.socks_port.set_value(float(socks.get("port") or 1080))
        self.socks_auto_start.set_active(bool(socks.get("auto_start", True)))
        self.socks_auto_stop.set_active(bool(socks.get("auto_stop", True)))
        self.http_enabled.set_active(bool(http.get("enabled", False)))
        self.http_port.set_value(float(http.get("port") or 3128))
        self.http_auto_start.set_active(bool(http.get("auto_start", False)))
        self.http_auto_stop.set_active(bool(http.get("auto_stop", False)))
        self._vm_touched = set()
        self._fill_vm_rows()
        self._filling = False
        self._dirty = False
        self._update_buttons()

    def _fill_vm_rows(self):
        """Fill the VM rows: config value when managed, else the live
        instance value from the last status, else the template default."""
        vm_cfg = (self.cfg or {}).get("vm") or {}
        vm_live = ((self.win.status or {}).get("vm") or {})
        guest = ((self.win.status or {}).get("guest") or {})

        def live_mib(key, bytes_key):
            val = vm_live.get(bytes_key) or guest.get(bytes_key)
            if isinstance(val, (int, float)) and val > 0:
                return int(round(val / 1048576))
            return None

        live = {
            "cpus": vm_live.get("cpus"),
            "memory_mib": live_mib("memory_mib", "memory_bytes"),
            "disk_gib": (
                int(round(vm_live["disk_bytes"] / 1073741824))
                if isinstance(vm_live.get("disk_bytes"), (int, float))
                and vm_live["disk_bytes"] > 0
                else None
            ),
            "swap_mib": live_mib("swap_mib", "swap_total_bytes"),
        }
        defaults = {"cpus": 2, "memory_mib": 512, "disk_gib": 20,
                    "swap_mib": 0}

        def pick(key):
            if vm_cfg.get(key) is not None:
                return vm_cfg[key]
            if live.get(key) is not None:
                return live[key]
            return defaults[key]

        was_filling = self._filling
        self._filling = True
        self.vm_cpus_row.set_value(float(pick("cpus")))
        self.vm_mem_row.set_value(float(pick("memory_mib")))
        self.vm_disk_row.set_value(float(pick("disk_gib")))
        self.vm_swap_row.set_value(float(pick("swap_mib")))
        swappiness = vm_cfg.get("swappiness")
        self.vm_swappiness_sw.set_active(swappiness is not None)
        self.vm_swappiness_row.set_value(
            float(swappiness if swappiness is not None else 60)
        )
        self.vm_swappiness_row.set_sensitive(swappiness is not None)
        self._filling = was_filling

    def _collect(self):
        cfg = self.cfg
        cfg["gateway"] = self.gw_row.get_text().strip()
        cfg["port"] = int(self.port_row.get_value())
        cfg["username"] = self.user_row.get_text().strip()
        socks = cfg.setdefault("socks_proxy", {})
        socks["enabled"] = self.socks_enabled.get_active()
        socks["port"] = int(self.socks_port.get_value())
        socks["auto_start"] = self.socks_auto_start.get_active()
        socks["auto_stop"] = self.socks_auto_stop.get_active()
        http = cfg.setdefault("http_proxy", {})
        http["enabled"] = self.http_enabled.get_active()
        http["port"] = int(self.http_port.get_value())
        http["auto_start"] = self.http_auto_start.get_active()
        http["auto_stop"] = self.http_auto_stop.get_active()
        vc.update_vm_config(
            cfg,
            {
                "cpus": int(self.vm_cpus_row.get_value()),
                "memory_mib": int(self.vm_mem_row.get_value()),
                "disk_gib": int(self.vm_disk_row.get_value()),
                "swap_mib": int(self.vm_swap_row.get_value()),
                "swappiness": (
                    int(self.vm_swappiness_row.get_value())
                    if self.vm_swappiness_sw.get_active()
                    else None
                ),
            },
            getattr(self, "_vm_touched", set()),
        )

    def _mark_dirty_vm(self, key):
        self._vm_touched.add(key)
        self._mark_dirty()

    def _mark_dirty(self, *_args):
        if self._filling:
            return
        self._dirty = True
        self._update_buttons()

    def _update_buttons(self):
        self.apply_btn.set_sensitive(self._dirty)
        self.revert_btn.set_sensitive(self._dirty)

    def _on_apply(self, *_args):
        if not self.gw_row.get_text().strip() or not self.user_row.get_text().strip():
            self.win.toast("Gateway and username must not be empty")
            return
        self._collect()
        try:
            vc.save_config(self.path, self.cfg)
        except OSError as exc:
            self.win.toast("Saving failed: %s" % exc)
            return
        self._dirty = False
        self._update_buttons()
        self.win.toast("Settings saved")
        self.win.refresh_now()

    def _on_revert(self, *_args):
        self.load(self.path)
        self.win.toast("Settings reverted")

    # -- password actions ----------------------------------------------------------

    def _on_pw_save(self, *_args):
        password = self.pw_entry.get_text()
        if not password:
            self.win.toast("Enter a password first")
            return

        def done(rc, _out, err):
            if rc == vc.EXIT_OK:
                self.pw_entry.set_text("")
                self.win.toast("Password saved to keyring")
                self.win.refresh_now()
            else:
                self.win.toast(
                    "Saving failed: %s" % (_last_line(err) or "exit %s" % rc)
                )

        vc.run_cli(
            ["password-set", "--stdin"], done, stdin_text=password + "\n"
        )

    def _on_pw_remove(self, *_args):
        def done(rc, _out, err):
            if rc == vc.EXIT_OK:
                self.win.toast("Password removed from keyring")
                self.win.refresh_now()
            else:
                self.win.toast(
                    "Removal failed: %s" % (_last_line(err) or "exit %s" % rc)
                )

        vc.run_cli(["password-clear"], done)

    def _on_pw_move(self, *_args):
        password = (self.cfg or {}).get("password")
        if not password:
            self.win.toast("No plaintext password in the config")
            return

        def done(rc, _out, err):
            if rc != vc.EXIT_OK:
                self.win.toast(
                    "Keyring save failed: %s"
                    % (_last_line(err) or "exit %s" % rc)
                )
                return
            self.cfg.pop("password", None)
            try:
                vc.save_config(self.path, self.cfg)
            except OSError as exc:
                self.win.toast("Saving config failed: %s" % exc)
                return
            self.win.toast("Password moved to keyring")
            self.win.refresh_now()

        vc.run_cli(
            ["password-set", "--stdin"], done, stdin_text=password + "\n"
        )

    # -- certificate -----------------------------------------------------------------

    def _on_cert_forget(self, *_args):
        dialog = Adw.AlertDialog(
            heading="Forget saved fingerprint?",
            body="The next connection will ask to trust the server "
            "certificate again.",
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("forget", "_Forget")
        dialog.set_response_appearance(
            "forget", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response != "forget":
                return

            def done(rc, out, err):
                if rc == vc.EXIT_OK:
                    self.win.toast(_last_line(out) or "Fingerprint forgotten")
                    self.win.refresh_now()
                else:
                    self.win.toast(
                        "Failed: %s" % (_last_line(err) or "exit %s" % rc)
                    )

            vc.run_cli(["cert-forget"], done)

        dialog.connect("response", on_response)
        dialog.present(self.get_root())

    # -- startup -----------------------------------------------------------------------

    def _on_startup_toggled(self, row, _param):
        if self._filling:
            return
        try:
            vc.set_autostart(row.get_active(), TRAY_PATH)
        except OSError as exc:
            self.win.toast("Autostart failed: %s" % exc)

    # -- delete -----------------------------------------------------------------------

    def _on_delete_vm(self, *_args):
        vm_name = ((self.win.status or {}).get("vm") or {}).get("name") or ""
        dialog = Adw.AlertDialog(
            heading="Delete the virtual machine?",
            body="This permanently removes the VM '%s' and its disk image. "
            "This cannot be undone." % vm_name,
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("delete", "_Delete")
        dialog.set_response_appearance(
            "delete", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "delete":
                self.win.run_action(
                    "Delete VM", ["delete", "--force"], force=True
                )

        dialog.connect("response", on_response)
        dialog.present(self.get_root())

    # -- VM apply / force stop ------------------------------------------------------

    def _on_vm_apply(self, *_args):
        pending = bool(
            (self.win.status or {}).get("vm_pending_restart")
        )
        if not pending:
            self.win.run_action(
                "Apply VM settings", ["vm-apply", "-y"], force=True,
                stream=True,
            )
            return
        dialog = Adw.AlertDialog(
            heading="Apply VM settings?",
            body="The VM will restart and the VPN will disconnect.",
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("apply", "_Apply")
        dialog.set_response_appearance(
            "apply", Adw.ResponseAppearance.SUGGESTED
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "apply":
                self.win.run_action(
                    "Apply VM settings", ["vm-apply", "-y"], force=True,
                    stream=True,
                )

        dialog.connect("response", on_response)
        dialog.present(self.get_root())

    def _on_force_stop(self, *_args):
        dialog = Adw.AlertDialog(
            heading="Force stop the VM?",
            body="Aborts any running vmvpn operation and stops the VM "
            "immediately. Unsaved guest data may be lost.",
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("force", "_Force stop")
        dialog.set_response_appearance(
            "force", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "force":
                self.win.run_action(
                    "Force stop VM", ["stop", "--force"], force=True
                )

        dialog.connect("response", on_response)
        dialog.present(self.get_root())


