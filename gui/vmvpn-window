        self._stream_proc = None    # Gio.Subprocess for guest follow mode
        self._stream_src = None
        self._file_offset = None    # appended-bytes tracking for file follow
        self._file_partial = b""

    # -- source list -----------------------------------------------------------

    @staticmethod
    def _factory_setup(_factory, item):
        label = Gtk.Label(xalign=0.0)
        label.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        item.set_child(label)

    @staticmethod
    def _factory_bind(_factory, item):
        src = item.get_item()
        label = item.get_child()
        label.set_label(src.name)
        label.set_sensitive(src.enabled)

    def _build_sources(self, status):
        st = status or {}
        vm = st.get("vm") or {}
        vm_running = vm.get("status") == "Running"
        vm_dir = vm.get("dir") or ""
        sources = [
            LogSource("VPN (live)", "guest", "vpn", enabled=vm_running),
            LogSource("FortiClient", "guest", "forticlient", enabled=vm_running),
            LogSource("Squid", "guest", "squid", enabled=vm_running),
            LogSource("Guest journal", "guest", "journal", enabled=vm_running),
            LogSource("GUI activity", "file", vc.gui_log_path()),
        ]
        if vm_dir:
            for label, fname in (
                ("Lima host agent", "ha.stderr.log"),
                ("Lima host agent (stdout)", "ha.stdout.log"),
                ("Lima serial log", "serial.log"),
                ("Lima serial log (verbose)", "serialv.log"),
            ):
                path = os.path.join(vm_dir, fname)
                if os.path.exists(path):
                    sources.append(LogSource(label, "file", path))
        return sources

    def update_status(self, status, _busy):
        sources = self._build_sources(status)
        sig = tuple((s.name, s.kind, s.ref, s.enabled) for s in sources)
        if sig == self._sources_sig:
            return
        prev_ref = None
        cur = self._current_source()
        if cur is not None:
            prev_ref = (cur.kind, cur.ref)
        self._sources_sig = sig
        self.model.remove_all()
        selected = 0
        for i, src in enumerate(sources):
            self.model.append(src)
            if (src.kind, src.ref) == prev_ref:
                selected = i
        self.dropdown.set_selected(selected)
        # set_selected does not emit notify::selected if index unchanged
        self._on_selected()

    def _current_source(self):
        idx = self.dropdown.get_selected()
        if idx == Gtk.INVALID_LIST_POSITION:
            return None
        return self.model.get_item(idx)

    def _on_selected(self, *_args):
        self._sync()

    def shutdown(self):
        """Stop timers and the log stream (window close)."""
        self._disarm_auto()
        self._stop_stream()

    # -- loading --------------------------------------------------------------

    def _set_text(self, text):
        self.buffer.set_text(text)
        GLib.idle_add(self._scroll_to_end)

    def _append_line(self, line):
        """Append one line; scroll only if the view is already at the bottom."""
        adj = self.scrolled.get_vadjustment()
        at_bottom = (
            adj.get_upper() - adj.get_page_size() - adj.get_value() < 40
        )
        self.buffer.insert(self.buffer.get_end_iter(), line + "\n")
        excess = self.buffer.get_line_count() - STREAM_MAX_LINES
        if excess > 0:
            self.buffer.delete(
                self.buffer.get_start_iter(),
                self.buffer.get_iter_at_line(excess),
            )
        if at_bottom:
            GLib.idle_add(self._scroll_to_end)

    def _scroll_to_end(self):
        end = self.buffer.get_end_iter()
        self.text_view.scroll_to_iter(end, 0.0, True, 0.0, 1.0)
        return GLib.SOURCE_REMOVE

    def _sync(self):
        """(Re)load the selected source and (re)arm its live mechanism."""
        self._disarm_auto()
        self._stop_stream()
        self._file_offset = None
        self._file_partial = b""
        src = self._current_source()
        if src is None:
            return
        follow = self.follow_btn.get_active()
        if src.kind == "guest":
            if not src.enabled:
                self._set_text("VM is not running.\n")
            elif follow:
                self._start_stream(src)
            else:
                self._reload_guest(src)
                self._timer = GLib.timeout_add_seconds(
                    GUEST_LOG_SECONDS, self._auto_tick
                )
        else:
            self._load_file_tail(src.ref)
            if follow:
                self._timer = GLib.timeout_add_seconds(
                    1, self._file_follow_tick
                )
            else:
                self._arm_file_monitor(src)

    def reload(self):
        self._sync()

    def _reload_current(self):
        src = self._current_source()
        if src is None:
            return
        if src.kind == "file":
            self._load_file_tail(src.ref)
        elif src.enabled:
            self._reload_guest(src)

    def _reload_guest(self, src):
        self._set_text("Loading %s…\n" % src.name)

        def done(rc, stdout, stderr):
            if self._current_source() is not src:
                return
            if rc == vc.EXIT_OK:
                self._set_text(stdout or "(no output)\n")
            else:
                detail = _last_line(stderr) or _last_line(stdout)
                vc.log_line(
                    "logs %s failed (exit %s): %s"
                    % (src.ref, rc, detail or "no output")
                )
                self._set_text(
                    "logs %s failed (exit %s):\n%s"
                    % (src.ref, rc, stderr or stdout)
                )

        vc.run_cli(
            ["logs", src.ref, "-n", str(LOG_MAX_LINES)], done, log=False
        )

    # -- live streaming ---------------------------------------------------------

    def _start_stream(self, src):
        """Follow a guest log via `vmvpn logs SRC -f` (unlogged stream).

        stdin is kept open: closing it makes the remote follower exit, so no
        orphaned tails remain in the guest when we stop or die.
        """
        self._set_text("")
        cli = vc.find_cli()
        if cli is None:
            self._set_text("vmvpn CLI not found\n")
            return
        try:
            proc = Gio.Subprocess.new(
                [cli, "logs", src.ref, "-f", "-n", "200"],
                Gio.SubprocessFlags.STDIN_PIPE
                | Gio.SubprocessFlags.STDOUT_PIPE
                | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as exc:
            self._set_text("Could not start the log stream: %s\n" % exc.message)
            return
        self._stream_proc = proc
        self._stream_src = src
        reader = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def on_line(stream, res):
            if self._stream_proc is not proc:
                return
            try:
                line = stream.read_line_finish_utf8(res)[0]
            except GLib.Error:
                line = None
            if line is None:
                if self._stream_proc is proc:
                    self._stream_proc = None
                    self._stream_src = None
                    self._append_line("— stream ended —")
                return
            self._append_line(line)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        reader.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def _stop_stream(self):
        proc = self._stream_proc
        self._stream_proc = None
        self._stream_src = None
        if proc is None:
            return
        try:
            proc.get_stdin_pipe().close(None)
        except Exception:
            pass
        try:
            proc.force_exit()
        except Exception:
            pass

    def _file_follow_tick(self):
        src = self._current_source()
        if src is None or src.kind != "file":
            return GLib.SOURCE_REMOVE
        try:
            size = os.path.getsize(src.ref)
        except OSError:
            return GLib.SOURCE_CONTINUE
        if self._file_offset is None:
            self._file_offset = size
            return GLib.SOURCE_CONTINUE
        if size < self._file_offset:
            # truncated/rotated: reload the tail
            self._file_offset = None
            self._file_partial = b""
            self._load_file_tail(src.ref)
            return GLib.SOURCE_CONTINUE
        if size == self._file_offset:
            return GLib.SOURCE_CONTINUE
        try:
            with open(src.ref, "rb") as f:
                f.seek(self._file_offset)
                data = self._file_partial + f.read(1024 * 1024)
                self._file_offset = f.tell()
        except OSError:
            return GLib.SOURCE_CONTINUE
        lines = data.split(b"\n")
        if data.endswith(b"\n"):
            self._file_partial = b""
        else:
            self._file_partial = lines.pop()
        for raw in lines:
            self._append_line(raw.decode("utf-8", "replace"))
        return GLib.SOURCE_CONTINUE

    def _load_file_tail(self, path):
        gfile = Gio.File.new_for_path(path)

        def on_info(f, res):
            try:
                info = f.query_info_finish(res)
                size = info.get_size()
            except GLib.Error as exc:
                self._set_text("Cannot read %s:\n%s\n" % (path, exc.message))
                return
            f.read_async(
                GLib.PRIORITY_DEFAULT,
                None,
                lambda f2, r2: self._on_stream(f2, r2, path, size),
            )

        gfile.query_info_async(
            "standard::size",
            Gio.FileQueryInfoFlags.NONE,
            GLib.PRIORITY_DEFAULT,
            None,
            on_info,
        )

    def _on_stream(self, gfile, res, path, size):
        try:
            stream = gfile.read_finish(res)
        except GLib.Error as exc:
            self._set_text("Cannot read %s:\n%s\n" % (path, exc.message))
            return
        start = max(0, size - FILE_TAIL_BYTES)
        if start:
            stream.seek(start, GLib.SeekType.SET, None)
        chunks = []

        def read_more():
            stream.read_bytes_async(
                65536, GLib.PRIORITY_DEFAULT, None, on_chunk
            )

        def on_chunk(s, r):
            try:
                data = s.read_bytes_finish(r).get_data()
            except GLib.Error:
                data = None
            if data:
                chunks.append(data)
                read_more()
                return
            text = b"".join(chunks).decode("utf-8", "replace")
            lines = text.splitlines()[-LOG_MAX_LINES:]
            out = "\n".join(lines)
            if start:
                out = "… (last %d lines)\n%s" % (len(lines), out)
            self._set_text(out + "\n")
            try:
                self._file_offset = stream.tell()
            except GLib.Error:
                self._file_offset = size
            stream.close(None)

        read_more()

    # -- non-follow auto refresh -------------------------------------------------

    def _disarm_auto(self):
        if self._monitor is not None:
            self._monitor.cancel()
            self._monitor = None
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = 0

    def _arm_file_monitor(self, src):
        try:
            gfile = Gio.File.new_for_path(src.ref)
            self._monitor = gfile.monitor_file(
                Gio.FileMonitorFlags.NONE, None
            )
            self._monitor.connect("changed", lambda *_: self._reload_current())
        except GLib.Error:
            self._timer = GLib.timeout_add_seconds(
                FILE_WATCH_SECONDS, self._auto_tick
            )

    def _auto_tick(self):
        self._reload_current()
        return GLib.SOURCE_CONTINUE

    # -- actions -----------------------------------------------------------------

    def _copy_all(self, *_args):
        text = self.buffer.get_text(
            self.buffer.get_start_iter(), self.buffer.get_end_iter(), False
        )
        self.get_clipboard().set_text(text)
        self.win.toast("Log copied to clipboard")

    def _open_folder(self, *_args):
        src = self._current_source()
        target = None
        if src is not None:
            if src.kind == "file":
                target = os.path.dirname(src.ref)
            else:
                vm = (self.win.status or {}).get("vm") or {}
                target = vm.get("dir")
        if not target:
            return
        launcher = Gtk.FileLauncher.new(Gio.File.new_for_path(target))
        launcher.launch(self.get_root(), None, None)


