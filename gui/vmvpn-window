ICON_FALLBACK = "network-vpn"


def _fmt_size(num):
    if num is None:
        return "—"
    return GLib.format_size(int(num))


def _last_line(text):
    for line in reversed((text or "").splitlines()):
        if line.strip():
            return line.strip()
    return ""


def _escape(text):
    return GLib.markup_escape_text(text or "")


