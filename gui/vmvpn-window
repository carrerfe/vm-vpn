def _icon_file(name):
    return os.path.join(ICON_DIR, name + ".svg")


def _fmt_size(num):
    if num is None:
        return "—"
    return GLib.format_size(int(num))


def _last_line(text):
    for line in reversed((text or "").splitlines()):
        if line.strip():
            return line.strip()
    return ""


def _readable_error(stdout, stderr):
    """Pick a human-readable error line from CLI output.

    First pass prefers the specific 'Could not reach…' line the CLI emits;
    second pass takes the last 'Could not …'/'Error…'/'failed' line so
    generic trailing noise like FortiClient's 'DONE.' is skipped.
    """
    for text in (stderr, stdout):
        for line in reversed((text or "").splitlines()):
            line = line.strip()
            if "check the address" in line.lower() \
                    or line.lower().startswith("could not reach"):
                return line
    for text in (stderr, stdout):
        for line in reversed((text or "").splitlines()):
            line = line.strip()
            if not line:
                continue
            low = line.lower()
            if (
                low.startswith("could not")
                or low.startswith("error")
                or "failed" in low
            ):
                return line
    return _last_line(stderr) or _last_line(stdout)


def _escape(text):
    return GLib.markup_escape_text(text or "")


