        self.vm_create.add_css_class("suggested-action")
        self.vm_create.connect("clicked", self._on_create_vm)
        self.vm_next = Gtk.Button(label="Next")
        self.vm_next.add_css_class("suggested-action")
        self.vm_next.set_visible(False)
        self.vm_next.connect(
            "clicked", lambda *_: self.nav.push(self._page_done())
        )
        actions = self._actions_box(
            self.vm_bg, self.vm_abort, self.vm_create, self.vm_next
        )

        vm = ((self.win.status or {}).get("vm") or {})
        if vm.get("exists"):
            self.vm_status_row.set_subtitle("The VM is ready")
            self.vm_create.set_visible(False)
            self.vm_next.set_visible(True)
        else:
            self.vm_status_row.set_subtitle("Not created yet")
        return self._page("Virtual machine", box, actions)

    def _on_create_vm(self, *_args):
        self.vm_create.set_visible(False)
        self.vm_error.set_visible(False)
        self.vm_spinner.start()
        self.vm_phase.set_label("Starting…")
        self.vm_bg.set_visible(True)
        self.vm_abort.set_visible(True)
        started = time.monotonic()

        # Mirror progress on the main window's status page too.
        self.win.action_running = True
        self.win.action = "create"
        self.win._progress_start("Creating the VM")
        self.win._apply_status()

        import collections

        lines = collections.deque(maxlen=200)

        def on_line(line):
            lines.append(line)
            if line.startswith("==> "):
                phase = line[4:]
            else:
                phase = self.win.progress["phase"]
            elapsed = int(time.monotonic() - started)
            self.vm_phase.set_label(
                "%s  %02d:%02d" % (phase, elapsed // 60, elapsed % 60)
            )
            self.vm_details_view.get_buffer().set_text(
                "\n".join(list(lines)[-200:])
            )
            self.win._progress_line(line)

        def done(rc, _out, err):
            self.vm_spinner.stop()
            self.vm_abort.set_visible(False)
            self.win.action_running = False
            self.win.action = None
            self.win._progress_stop()
            self.win._apply_status()
            self.win._poll()
            if rc == vc.EXIT_OK:
                self._vm_done_ok = True
                self.vm_status_row.set_subtitle("The VM is ready")
                self.vm_phase.set_label("Done.")
                self.vm_create.set_visible(False)
                self.vm_bg.set_visible(False)
                self.vm_next.set_visible(True)
            else:
                self.vm_error.set_label(
                    "VM creation failed: %s"
                    % (_last_line(err) or "exit %s" % rc)
                )
                self.vm_error.set_visible(True)
                self.vm_phase.set_label("")
                self.vm_create.set_label("Retry")
                self.vm_create.set_sensitive(True)
                self.vm_create.set_visible(True)

        self._vm_proc = vc.run_cli(["start"], done, on_line=on_line)

    # -- page 4: done -------------------------------------------------------------

    def _page_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(12)
        box.set_margin_bottom(12)

        group = Adw.PreferencesGroup(title="Done")
        row = Adw.ActionRow(title="Setup complete")
        row.set_subtitle(
            "You can connect now. Everything stays available from the "
            "VM VPN window and the tray icon."
        )
        group.add(row)
        self.tray_row = Adw.SwitchRow(title="Show the tray icon at login")
        self.tray_row.set_active(True)
        group.add(self.tray_row)
        box.append(group)

        close_btn = Gtk.Button(label="Close")
        close_btn.connect("clicked", self._close)
        connect_btn = Gtk.Button(label="Connect now")
        connect_btn.add_css_class("suggested-action")
        connect_btn.connect("clicked", self._on_done_connect)
        actions = self._actions_box(close_btn, connect_btn)
        return self._page("Done", box, actions)

    def _apply_tray_pref(self):
        enabled = self.tray_row.get_active()
        try:
            vc.set_autostart(enabled, TRAY_PATH)
        except OSError:
            pass
        if enabled:
            # Start the tray now if it isn't running.
            try:
                import subprocess as _sp

                running = _sp.run(
                    ["pgrep", "-f", "vmvpn-tray"],
                    capture_output=True,
                ).returncode == 0
                if not running and os.access(TRAY_PATH, os.X_OK):
                    _sp.Popen(
                        [TRAY_PATH],
                        stdin=_sp.DEVNULL, stdout=_sp.DEVNULL,
                        stderr=_sp.DEVNULL,
                        start_new_session=True,
                    )
            except OSError:
                pass

    def _on_done_connect(self, *_args):
        self._apply_tray_pref()
        password, self.password = self.password, None
        self.close()
        self.win._start_connect(password=password)


class MainWindow(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(
            application=application,
            title="VM VPN",
            default_width=720,
            default_height=640,
        )
        self.status = None
        self.action_running = False
        self.action = None
        self.flow = None
        self.poll_in_flight = False
        self.last_failed = False
        self.progress = None          # dict while a streamed action runs
        self._assistant = None
        self._assistant_shown = False
        self._poll_log = vc.StatusPollLogger()
        self._last_refresh = "—"

        self.stack = Adw.ViewStack()
        self.status_page = StatusPage(self)
        self.logs_page = LogsPage(self)
        self.settings_page = SettingsPage(self)
        self.stack.add_titled_with_icon(
            self.status_page, "status", "Status", "computer-symbolic"
        )
        self.stack.add_titled_with_icon(
            self.logs_page, "logs", "Logs", "text-x-generic-symbolic"
        )
        self.stack.add_titled_with_icon(
            self.settings_page, "settings", "Settings",
            "emblem-system-symbolic",
        )

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        switcher = Adw.ViewSwitcher(
            stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE
        )
        header.set_title_widget(switcher)
        menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic")
        menu = Gio.Menu()
        menu.append("Refresh", "win.refresh")
        menu.append("About", "app.about")
        menu.append("Quit", "app.quit")
        menu_button.set_menu_model(menu)
        header.pack_end(menu_button)
        toolbar.add_top_bar(header)

        self.toast_overlay = Adw.ToastOverlay()
        self.toast_overlay.set_child(self.stack)
        toolbar.set_content(self.toast_overlay)
        self.set_content(toolbar)

        refresh_action = Gio.SimpleAction.new("refresh", None)
        refresh_action.connect("activate", lambda *_: self.refresh_now())
        self.add_action(refresh_action)

        self.connect("map", lambda *_: self._poll())
        self.connect("close-request", self._on_close)
        GLib.timeout_add_seconds(POLL_SECONDS, self._poll_tick)
        self._apply_status()

    def show_page(self, name):
        if name == "setup":
            self.open_assistant()
            return
        if name in ("status", "logs", "settings"):
            self.stack.set_visible_child_name(name)

    def open_assistant(self):
        if self._assistant is not None:
            self._assistant.present()
            return
        self._assistant = SetupAssistant(self)
        self._assistant.connect(
            "close-request", self._on_assistant_closed
        )
        self._assistant.present()

    def _on_assistant_closed(self, *_args):
        self._assistant = None
        self.refresh_now()
        return False

    def _maybe_open_assistant(self):
        """Open the assistant once on startup when there is no usable config."""
        if self._assistant_shown or self._assistant is not None:
            return
        if self.status is None:
            return
        cfg = self._cfg()
        if not (cfg.get("exists") and cfg.get("valid")):
            self._assistant_shown = True
            self.open_assistant()

    def _on_close(self, *_args):
        self.logs_page.shutdown()
        return False

    # -- helpers ------------------------------------------------------------------

    def toast(self, message):
        self.toast_overlay.add_toast(Adw.Toast.new(message))

    def refresh_now(self):
        self._poll()

    def _busy(self):
        return self.action_running or bool(
            (self.status or {}).get("busy")
        )

    def _cfg(self):
        return (self.status or {}).get("config") or {}

    # -- polling ---------------------------------------------------------------------

    def _poll_tick(self):
        if self.get_mapped():
            self._poll()
        return GLib.SOURCE_CONTINUE

    def _poll(self):
        if self.poll_in_flight:
            return
        self.poll_in_flight = True
        vc.run_cli(["status", "--json"], self._on_polled, log=False)

    def _on_polled(self, rc, stdout, stderr):
        self.poll_in_flight = False
        parsed = vc.parse_status(stdout) if rc == vc.EXIT_OK else None
        self._poll_log.report(parsed is not None, stderr)
        if parsed is not None:
            self.status = parsed
            self._last_refresh = time.strftime("%H:%M:%S")
        self._apply_status()

    def _apply_status(self):
        busy = self._busy()
        self.status_page._last_refresh = self._last_refresh
        self.status_page.update(
            self.status, busy, self.action, self.last_failed
        )
        self.logs_page.update_status(self.status, busy)
        self.settings_page.update_status(self.status, busy)
        self._maybe_open_assistant()

    # -- progress (streamed long-running actions) -------------------------------------

    def _progress_start(self, label):
        import collections

        self.progress = {
            "label": label,
            "phase": "",
            "started": time.monotonic(),
            "lines": collections.deque(maxlen=200),
        }
        GLib.timeout_add(1000, self._progress_tick)

    def _progress_tick(self):
        if self.progress is None:
            return GLib.SOURCE_REMOVE
        # re-render the elapsed clock once a second
        self.status_page.update(
            self.status, self._busy(), self.action, self.last_failed
        )
        return GLib.SOURCE_CONTINUE

    def _progress_line(self, line):
        if self.progress is None:
            return
        self.progress["lines"].append(line)
        if line.startswith("==> "):
            self.progress["phase"] = line[4:]
        self.status_page.update(
            self.status, self._busy(), self.action, self.last_failed
        )

    def _progress_stop(self):
        self.progress = None

    # -- actions -----------------------------------------------------------------------

    def run_action(self, label, args, force=False, stream=False):
        if self._busy() and not force:
            return
        self.action_running = True
        self.action = label
        if stream:
            self._progress_start(label)
        self._apply_status()

        def done(rc, stdout, stderr):
            self.action_running = False
            self.action = None
            self._progress_stop()
            if rc == vc.EXIT_BUSY:
                self.toast("Another vmvpn operation is in progress")
            elif rc == vc.EXIT_OK:
                self.last_failed = False
                self.toast("%s: done" % label)
            else:
                self.last_failed = True
                detail = _readable_error(stdout, stderr)
                self.toast(
                    "%s failed: %s" % (label, detail or "exit %s" % rc)
                )
            self._apply_status()
            self._poll()

        vc.run_cli(args, done, on_line=self._progress_line if stream else None)

    def _on_connect_clicked(self, *_args):
        if self._busy():
            return
        if ((self.status or {}).get("vpn") or {}).get("state") == "connected":
            self.run_action("Disconnect", ["vpn-disconnect"], stream=True)
            return
        # First connection may need to create the VM (5–15 minutes): say so.
        vm_exists = bool(
            ((self.status or {}).get("vm") or {}).get("exists")
        )
        if not vm_exists:
            dialog = Adw.AlertDialog(
                heading="Create the VM?",
                body=(
                    "The first connection creates the VM — it downloads "
                    "Ubuntu and installs the VPN client, which takes "
                    "5–15 minutes and happens once."
                ),
            )
            dialog.add_response("cancel", "_Cancel")
            dialog.add_response("create", "_Create && Connect")
            dialog.set_response_appearance(
                "create", Adw.ResponseAppearance.SUGGESTED
            )
            dialog.set_close_response("cancel")
            dialog.connect(
                "response",
                lambda _d, r: self._start_connect() if r == "create" else None,
            )
            dialog.present(self)
            return
        self._start_connect()

    def _start_connect(self, password=None):
        if self._busy():
            return
        self.action_running = True
        self.action = "connect"
        self._progress_start("Connecting to VPN")
        self._apply_status()
        self.flow = vc.ConnectFlow(
            self._ask_password,
            self._ask_trust,
            self._connect_done,
            password=password,
            on_warning=lambda msg: self.toast(
                "Could not save password to keyring: %s" % msg
            ),
            on_line=self._progress_line,
        )
        self.flow.start()

    def _connect_done(self, rc, stdout, stderr):
        self.flow = None
        self.action_running = False
        self.action = None
        self._progress_stop()
        if rc == vc.EXIT_OK:
            self.last_failed = False
            self.toast("VPN connected")
        elif rc == vc.EXIT_BUSY:
            self.toast("Another vmvpn operation is in progress")
        elif rc != vc.EXIT_PASSWORD_REQUIRED:
            self.last_failed = True
            detail = _readable_error(stdout, stderr)
            self.toast("Connect failed: %s" % (detail or "exit %s" % rc))
        self._apply_status()
        self._poll()

    def _on_firefox(self, *_args):
        self.run_action("Launch Firefox", ["firefox"])

    def _copy_proxy(self, kind):
        proxy = ((self.status or {}).get("proxies") or {}).get(kind) or {}
        port = proxy.get("port")
        if not port:
            return
        url = (
            "socks5h://127.0.0.1:%s" if kind == "socks" else "http://127.0.0.1:%s"
        ) % port
        self.get_clipboard().set_text(url)
        self.toast("Copied %s" % url)

    # -- connect dialogs --------------------------------------------------------------

    def _ask_password(self, error_message, cb):
        cfg = self._cfg()
        username = cfg.get("username")
        gateway = cfg.get("gateway")
        if username and gateway:
            body = "VPN password for %s@%s" % (username, gateway)
        else:
            body = "Enter the VPN password"

        dialog = Adw.AlertDialog(heading="VPN password", body=body)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        if error_message:
            err = Gtk.Label(label=error_message, xalign=0.0)
            err.add_css_class("error")
            err.set_wrap(True)
            box.append(err)
        group = Adw.PreferencesGroup()
        entry = Adw.PasswordEntryRow(title="Password")
        group.add(entry)
        box.append(group)
        remember = Gtk.CheckButton(label="Remember in GNOME keyring")
        box.append(remember)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("connect", "_Connect")
        dialog.set_response_appearance(
            "connect", Adw.ResponseAppearance.SUGGESTED
        )
        dialog.set_default_response("connect")
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "connect":
                password = entry.get_text()
                cb(password if password else None, remember.get_active())
            else:
                cb(None, False)

        dialog.connect("response", on_response)
        dialog.present(self)
        return dialog

    def _ask_trust(self, new_fp, saved_fp, cb):
        if saved_fp:
            heading = "VPN server certificate has changed"
            body = (
                "Saved fingerprint:\n<tt>%s</tt>\n\nNew fingerprint:\n"
                "<tt>%s</tt>\n\nThis could indicate a man-in-the-middle "
                "attack or a legitimate certificate update.\n"
                "Trust the new certificate?"
                % (_escape(saved_fp), _escape(new_fp))
            )
            appearance = Adw.ResponseAppearance.DESTRUCTIVE
        else:
            heading = "New VPN server certificate"
            body = (
                "Fingerprint (SHA1):\n<tt>%s</tt>\n\n"
                "Trust this certificate and save the fingerprint?"
                % _escape(new_fp)
            )
            appearance = Adw.ResponseAppearance.SUGGESTED

        dialog = Adw.AlertDialog(heading=heading)
        dialog.set_body_use_markup(True)
        dialog.set_body(body)
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("trust", "_Trust")
        dialog.set_response_appearance("trust", appearance)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: cb(r == "trust"))
        dialog.present(self)
        return dialog


class VmVpnApp(Adw.Application):
    _PAGES = ("status", "logs", "settings", "setup")

    def __init__(self):
        super().__init__(
            application_id="io.github.carrerfe.VmVpn",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.add_main_option(
            "page",
            0,
            GLib.OptionFlags.NONE,
            GLib.OptionArg.STRING,
            "Page to show: status, logs or settings",
            "PAGE",
        )
        self._pending_page = None
        self.connect("activate", self._on_activate)

        about = Gio.SimpleAction.new("about", None)
        about.connect("activate", self._on_about)
        self.add_action(about)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)

    def do_command_line(self, command_line):
        options = command_line.get_options_dict()
        page = None
        if options.contains("page"):
            page = options.lookup_value(
                "page", GLib.VariantType("s")
            ).get_string()
        if page is not None and page not in self._PAGES:
            command_line.printerr_literal(
                "vmvpn-window: unknown page '%s'\n" % page
            )
            return 1
        self.activate()
        win = self.props.active_window
        if page is None:
            return 0
        if win is not None:
            win.show_page(page)
        else:
            self._pending_page = page
        return 0

    def _on_activate(self, app):
        win = self.props.active_window
        if win is None:
            win = MainWindow(application=self)
        win.present()
        if self._pending_page is not None:
            win.show_page(self._pending_page)
            self._pending_page = None

    def _on_about(self, *_args):
        win = self.props.active_window
        cli_version = "unknown"
        if win is not None:
            cli_version = (win.status or {}).get("version") or "unknown"
        debug_info = "CLI: %s\nCLI path: %s" % (
            cli_version,
            vc.find_cli() or "not found",
        )
        about = Adw.AboutWindow(
            transient_for=win,
            application_name="VM VPN",
            application_icon="network-vpn",
            version=vc.VERSION,
            debug_info=debug_info,
            comments=(
                "Control window for the Lima-based FortiClient VPN "
                "virtual machine."
            ),
        )
        about.present()


def main():
    if any(a in ("--version", "-V") for a in sys.argv[1:]):
        print("vmvpn-window %s" % vc.VERSION)
        return 0
    app = VmVpnApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
