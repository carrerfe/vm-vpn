    # -- load/save ---------------------------------------------------------------

    def _resolve_path(self, status):
        cfg = ((status or {}).get("config") or {})
        if cfg.get("path"):
            return cfg["path"]
        env_path = os.environ.get("VPN_CONFIG")
        if env_path:
            return env_path
        cli = vc.find_cli()
        if cli:
            return os.path.join(os.path.dirname(cli), "vpn-config.json")
        return os.path.join(SCRIPT_DIR, "..", "vpn-config.json")

    def update_status(self, status, _busy):
        if self.cfg is None:
            self.load(self._resolve_path(status))
        cfg = (status or {}).get("config") or {}
        source = cfg.get("password_source") or "none"
        labels = {
            "keyring": "Keyring",
            "config": "Config file (plaintext)",
            "none": "Not stored",
        }
        self.pw_source_row.set_subtitle(labels.get(source, source))
        for cls in ("warning",):
            self.pw_source_row.remove_css_class(cls)
        if source == "config":
            self.pw_source_row.add_css_class("warning")
        self.pw_move.set_visible(source == "config")
        fp = ((status or {}).get("cert") or {}).get("fingerprint")
        self.cert_row.set_subtitle(str(fp) if fp else "None saved")

    def load(self, path):
        self.path = path
        self.cfg = vc.load_config(path)
        self._fill()

    def _fill(self):
        self._filling = True
        cfg = self.cfg or {}
        self.gw_row.set_text(str(cfg.get("gateway") or ""))
        self.port_row.set_value(float(cfg.get("port") or 443))
        self.user_row.set_text(str(cfg.get("username") or ""))
        socks = cfg.get("socks_proxy") or {}
        http = cfg.get("http_proxy") or {}
        self.socks_enabled.set_active(bool(socks.get("enabled", True)))
        self.socks_port.set_value(float(socks.get("port") or 1080))
        self.socks_auto_start.set_active(bool(socks.get("auto_start", True)))
        self.socks_auto_stop.set_active(bool(socks.get("auto_stop", True)))
        self.http_enabled.set_active(bool(http.get("enabled", False)))
        self.http_port.set_value(float(http.get("port") or 3128))
        self.http_auto_start.set_active(bool(http.get("auto_start", False)))
        self.http_auto_stop.set_active(bool(http.get("auto_stop", False)))
        self._filling = False
        self._dirty = False
        self._update_buttons()

    def _collect(self):
        cfg = self.cfg
        cfg["gateway"] = self.gw_row.get_text().strip()
        cfg["port"] = int(self.port_row.get_value())
        cfg["username"] = self.user_row.get_text().strip()
        socks = cfg.setdefault("socks_proxy", {})
        socks["enabled"] = self.socks_enabled.get_active()
        socks["port"] = int(self.socks_port.get_value())
        socks["auto_start"] = self.socks_auto_start.get_active()
        socks["auto_stop"] = self.socks_auto_stop.get_active()
        http = cfg.setdefault("http_proxy", {})
        http["enabled"] = self.http_enabled.get_active()
        http["port"] = int(self.http_port.get_value())
        http["auto_start"] = self.http_auto_start.get_active()
        http["auto_stop"] = self.http_auto_stop.get_active()

    def _mark_dirty(self, *_args):
        if self._filling:
            return
        self._dirty = True
        self._update_buttons()

    def _update_buttons(self):
        self.apply_btn.set_sensitive(self._dirty)
        self.revert_btn.set_sensitive(self._dirty)

    def _on_apply(self, *_args):
        if not self.gw_row.get_text().strip() or not self.user_row.get_text().strip():
            self.win.toast("Gateway and username must not be empty")
            return
        self._collect()
        try:
            vc.save_config(self.path, self.cfg)
        except OSError as exc:
            self.win.toast("Saving failed: %s" % exc)
            return
        self._dirty = False
        self._update_buttons()
        self.win.toast("Settings saved")
        self.win.refresh_now()

    def _on_revert(self, *_args):
        self.load(self.path)
        self.win.toast("Settings reverted")

    # -- password actions ----------------------------------------------------------

    def _on_pw_save(self, *_args):
        password = self.pw_entry.get_text()
        if not password:
            self.win.toast("Enter a password first")
            return

        def done(rc, _out, err):
            if rc == vc.EXIT_OK:
                self.pw_entry.set_text("")
                self.win.toast("Password saved to keyring")
                self.win.refresh_now()
            else:
                self.win.toast(
                    "Saving failed: %s" % (_last_line(err) or "exit %s" % rc)
                )

        vc.run_cli(
            ["password-set", "--stdin"], done, stdin_text=password + "\n"
        )

    def _on_pw_remove(self, *_args):
        def done(rc, _out, err):
            if rc == vc.EXIT_OK:
                self.win.toast("Password removed from keyring")
                self.win.refresh_now()
            else:
                self.win.toast(
                    "Removal failed: %s" % (_last_line(err) or "exit %s" % rc)
                )

        vc.run_cli(["password-clear"], done)

    def _on_pw_move(self, *_args):
        password = (self.cfg or {}).get("password")
        if not password:
            self.win.toast("No plaintext password in the config")
            return

        def done(rc, _out, err):
            if rc != vc.EXIT_OK:
                self.win.toast(
                    "Keyring save failed: %s"
                    % (_last_line(err) or "exit %s" % rc)
                )
                return
            self.cfg.pop("password", None)
            try:
                vc.save_config(self.path, self.cfg)
            except OSError as exc:
                self.win.toast("Saving config failed: %s" % exc)
                return
            self.win.toast("Password moved to keyring")
            self.win.refresh_now()

        vc.run_cli(
            ["password-set", "--stdin"], done, stdin_text=password + "\n"
        )

    # -- certificate -----------------------------------------------------------------

    def _on_cert_forget(self, *_args):
        dialog = Adw.AlertDialog(
            heading="Forget saved fingerprint?",
            body="The next connection will ask to trust the server "
            "certificate again.",
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("forget", "_Forget")
        dialog.set_response_appearance(
            "forget", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response != "forget":
                return

            def done(rc, out, err):
                if rc == vc.EXIT_OK:
                    self.win.toast(_last_line(out) or "Fingerprint forgotten")
                    self.win.refresh_now()
                else:
                    self.win.toast(
                        "Failed: %s" % (_last_line(err) or "exit %s" % rc)
                    )

            vc.run_cli(["cert-forget"], done)

        dialog.connect("response", on_response)
        dialog.present(self.get_root())

    # -- startup -----------------------------------------------------------------------

    def _on_startup_toggled(self, row, _param):
        if self._filling:
            return
        try:
            vc.set_autostart(row.get_active(), TRAY_PATH)
        except OSError as exc:
            self.win.toast("Autostart failed: %s" % exc)

    # -- delete -----------------------------------------------------------------------

    def _on_delete_vm(self, *_args):
        vm_name = ((self.win.status or {}).get("vm") or {}).get("name") or ""
        dialog = Adw.AlertDialog(
            heading="Delete the virtual machine?",
            body="This permanently removes the VM '%s' and its disk image. "
            "This cannot be undone." % vm_name,
        )
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("delete", "_Delete")
        dialog.set_response_appearance(
            "delete", Adw.ResponseAppearance.DESTRUCTIVE
        )
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "delete":
                self.win.run_action("Delete VM", ["delete", "-y"])

        dialog.connect("response", on_response)
        dialog.present(self.get_root())


class MainWindow(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(
            application=application,
            title="VM VPN",
            default_width=720,
            default_height=640,
        )
        self.status = None
        self.action_running = False
        self.action = None
        self.flow = None
        self.poll_in_flight = False
        self.last_failed = False
        self._poll_log = vc.StatusPollLogger()
        self._last_refresh = "—"

        self.stack = Adw.ViewStack()
        self.status_page = StatusPage(self)
        self.logs_page = LogsPage(self)
        self.settings_page = SettingsPage(self)
        self.stack.add_titled_with_icon(
            self.status_page, "status", "Status", "computer-symbolic"
        )
        self.stack.add_titled_with_icon(
            self.logs_page, "logs", "Logs", "text-x-generic-symbolic"
        )
        self.stack.add_titled_with_icon(
            self.settings_page, "settings", "Settings",
            "emblem-system-symbolic",
        )

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        switcher = Adw.ViewSwitcher(
            stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE
        )
        header.set_title_widget(switcher)
        menu_button = Gtk.MenuButton(icon_name="open-menu-symbolic")
        menu = Gio.Menu()
        menu.append("Refresh", "win.refresh")
        menu.append("About", "app.about")
        menu.append("Quit", "app.quit")
        menu_button.set_menu_model(menu)
        header.pack_end(menu_button)
        toolbar.add_top_bar(header)

        self.toast_overlay = Adw.ToastOverlay()
        self.toast_overlay.set_child(self.stack)
        toolbar.set_content(self.toast_overlay)
        self.set_content(toolbar)

        refresh_action = Gio.SimpleAction.new("refresh", None)
        refresh_action.connect("activate", lambda *_: self.refresh_now())
        self.add_action(refresh_action)

        self.connect("map", lambda *_: self._poll())
        GLib.timeout_add_seconds(POLL_SECONDS, self._poll_tick)
        self._apply_status()

    # -- helpers ------------------------------------------------------------------

    def toast(self, message):
        self.toast_overlay.add_toast(Adw.Toast.new(message))

    def refresh_now(self):
        self._poll()

    def _busy(self):
        return self.action_running or bool(
            (self.status or {}).get("busy")
        )

    def _cfg(self):
        return (self.status or {}).get("config") or {}

    # -- polling ---------------------------------------------------------------------

    def _poll_tick(self):
        if self.get_mapped():
            self._poll()
        return GLib.SOURCE_CONTINUE

    def _poll(self):
        if self.poll_in_flight:
            return
        self.poll_in_flight = True
        vc.run_cli(["status", "--json"], self._on_polled, log=False)

    def _on_polled(self, rc, stdout, stderr):
        self.poll_in_flight = False
        parsed = vc.parse_status(stdout) if rc == vc.EXIT_OK else None
        self._poll_log.report(parsed is not None, stderr)
        if parsed is not None:
            self.status = parsed
            self._last_refresh = time.strftime("%H:%M:%S")
        self._apply_status()

    def _apply_status(self):
        busy = self._busy()
        self.status_page._last_refresh = self._last_refresh
        self.status_page.update(
            self.status, busy, self.action, self.last_failed
        )
        self.logs_page.update_status(self.status, busy)
        self.settings_page.update_status(self.status, busy)

    # -- actions -----------------------------------------------------------------------

    def run_action(self, label, args):
        if self._busy():
            return
        self.action_running = True
        self.action = label
        self._apply_status()

        def done(rc, stdout, stderr):
            self.action_running = False
            self.action = None
            if rc == vc.EXIT_BUSY:
                self.toast("Another vmvpn operation is in progress")
            elif rc == vc.EXIT_OK:
                self.last_failed = False
                self.toast("%s: done" % label)
            else:
                self.last_failed = True
                detail = _last_line(stderr) or _last_line(stdout)
                self.toast(
                    "%s failed: %s" % (label, detail or "exit %s" % rc)
                )
            self._apply_status()
            self._poll()

        vc.run_cli(args, done)

    def _on_connect_clicked(self, *_args):
        if self._busy():
            return
        if ((self.status or {}).get("vpn") or {}).get("state") == "connected":
            self.run_action("Disconnect", ["vpn-disconnect"])
            return
        self.action_running = True
        self.action = "connect"
        self._apply_status()
        self.flow = vc.ConnectFlow(
            self._ask_password, self._ask_trust, self._connect_done
        )
        self.flow.start()

    def _connect_done(self, rc, stdout, stderr):
        self.flow = None
        self.action_running = False
        self.action = None
        if rc == vc.EXIT_OK:
            self.last_failed = False
            self.toast("VPN connected")
        elif rc == vc.EXIT_BUSY:
            self.toast("Another vmvpn operation is in progress")
        elif rc != vc.EXIT_PASSWORD_REQUIRED:
            self.last_failed = True
            detail = _last_line(stderr) or _last_line(stdout)
            self.toast("Connect failed: %s" % (detail or "exit %s" % rc))
        self._apply_status()
        self._poll()

    def _on_firefox(self, *_args):
        self.run_action("Launch Firefox", ["firefox"])

    def _copy_proxy(self, kind):
        proxy = ((self.status or {}).get("proxies") or {}).get(kind) or {}
        port = proxy.get("port")
        if not port:
            return
        url = (
            "socks5h://127.0.0.1:%s" if kind == "socks" else "http://127.0.0.1:%s"
        ) % port
        self.get_clipboard().set_text(url)
        self.toast("Copied %s" % url)

    # -- connect dialogs --------------------------------------------------------------

    def _ask_password(self, error_message, cb):
        cfg = self._cfg()
        username = cfg.get("username")
        gateway = cfg.get("gateway")
        if username and gateway:
            body = "VPN password for %s@%s" % (username, gateway)
        else:
            body = "Enter the VPN password"

        dialog = Adw.AlertDialog(heading="VPN password", body=body)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        if error_message:
            err = Gtk.Label(label=error_message, xalign=0.0)
            err.add_css_class("error")
            err.set_wrap(True)
            box.append(err)
        group = Adw.PreferencesGroup()
        entry = Adw.PasswordEntryRow(title="Password")
        group.add(entry)
        box.append(group)
        remember = Gtk.CheckButton(label="Remember in GNOME keyring")
        box.append(remember)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("connect", "_Connect")
        dialog.set_response_appearance(
            "connect", Adw.ResponseAppearance.SUGGESTED
        )
        dialog.set_default_response("connect")
        dialog.set_close_response("cancel")

        def on_response(_dlg, response):
            if response == "connect":
                password = entry.get_text()
                cb(password if password else None, remember.get_active())
            else:
                cb(None, False)

        dialog.connect("response", on_response)
        dialog.present(self)
        return dialog

    def _ask_trust(self, new_fp, saved_fp, cb):
        if saved_fp:
            heading = "VPN server certificate has changed"
            body = (
                "Saved fingerprint:\n<tt>%s</tt>\n\nNew fingerprint:\n"
                "<tt>%s</tt>\n\nThis could indicate a man-in-the-middle "
                "attack or a legitimate certificate update.\n"
                "Trust the new certificate?"
                % (_escape(saved_fp), _escape(new_fp))
            )
            appearance = Adw.ResponseAppearance.DESTRUCTIVE
        else:
            heading = "New VPN server certificate"
            body = (
                "Fingerprint (SHA1):\n<tt>%s</tt>\n\n"
                "Trust this certificate and save the fingerprint?"
                % _escape(new_fp)
            )
            appearance = Adw.ResponseAppearance.SUGGESTED

        dialog = Adw.AlertDialog(heading=heading)
        dialog.set_body_use_markup(True)
        dialog.set_body(body)
        dialog.add_response("cancel", "_Cancel")
        dialog.add_response("trust", "_Trust")
        dialog.set_response_appearance("trust", appearance)
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r: cb(r == "trust"))
        dialog.present(self)
        return dialog


class VmVpnApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.github.carrerfe.VmVpn")
        self.connect("activate", self._on_activate)

        about = Gio.SimpleAction.new("about", None)
        about.connect("activate", self._on_about)
        self.add_action(about)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)

    def _on_activate(self, app):
        win = self.props.active_window
        if win is None:
            win = MainWindow(application=self)
        win.present()

    def _on_about(self, *_args):
        about = Adw.AboutWindow(
            transient_for=self.props.active_window,
            application_name="VM VPN",
            application_icon="network-vpn",
            version="1.0",
            comments=(
                "Control window for the Lima-based FortiClient VPN "
                "virtual machine."
            ),
        )
        about.present()


def main():
    app = VmVpnApp()
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
