    # -- update ---------------------------------------------------------------

    def update(self, status, busy, action, last_failed):
        st = status or {}
        vm = st.get("vm") or {}
        guest = st.get("guest") or {}
        vpn = st.get("vpn") or {}
        proxies = st.get("proxies") or {}
        cfg = st.get("config") or {}
        cert = st.get("cert") or {}

        connected = vpn.get("state") == "connected"
        vm_running = vm.get("status") == "Running"
        config_valid = bool(cfg.get("exists") and cfg.get("valid"))

        # Header ------------------------------------------------------------
        if action == "connect":
            title, sub, icon = "Connecting…", "Hold on", ICON_ACQUIRING
        elif busy:
            title, sub, icon = "Working…", "", ICON_ACQUIRING
        elif status is None:
            title, sub, icon = "Status unavailable", "", ICON_NO_ROUTE
        elif not config_valid:
            title = "Not configured"
            sub = cfg.get("path") or ""
            icon = ICON_DISABLED
        elif not vm.get("exists"):
            title, sub, icon = "VM not created", "", ICON_DISABLED
        elif not vm_running:
            title, sub, icon = "VM stopped", "", ICON_DISABLED
        elif connected:
            title = "Connected — %s" % (cfg.get("gateway") or "")
            sub = ""
            icon = ICON_CONNECTED
        else:
            title, sub, icon = "Disconnected", "", ICON_DISCONNECTED
        if last_failed and not busy:
            icon = ICON_NO_ROUTE
        self.icon.set_from_icon_name(icon)
        self.title_label.set_label(title)
        self.subtitle_label.set_label(sub)
        self.subtitle_label.set_visible(bool(sub))

        # VPN group ----------------------------------------------------------
        self.row_state.set_subtitle(
            {
                "connected": "Connected",
                "disconnected": "Disconnected",
                "unknown": "Unknown",
            }.get(vpn.get("state") or "", "—")
        )
        if connected:
            self.conn_button.set_label("Disconnect")
            self.conn_button.remove_css_class("suggested-action")
            self.conn_button.add_css_class("destructive-action")
            self.conn_button.set_sensitive(not busy)
        else:
            self.conn_button.set_label("Connect")
            self.conn_button.remove_css_class("destructive-action")
            self.conn_button.add_css_class("suggested-action")
            self.conn_button.set_sensitive(
                not busy and config_valid and vm_running
            )
        self.row_gateway.set_subtitle(str(cfg.get("gateway") or "—"))
        self.row_username.set_subtitle(str(cfg.get("username") or "—"))

        socks = proxies.get("socks") or {}
        http = proxies.get("http") or {}
        self._proxy_row(self.row_socks, self.socks_copy, socks)
        self._proxy_row(self.row_http, self.http_copy, http)

        self.firefox_btn.set_sensitive(not busy and connected)

        raw = vpn.get("raw") or ""
        self.raw_label.set_markup(
            "<tt>%s</tt>" % _escape(raw if raw else "(no output)")
        )

        # VM group ------------------------------------------------------------
        self.row_vm_name.set_subtitle(str(vm.get("name") or "—"))
        self.row_vm_status.set_subtitle(
            str(vm.get("status") or ("Not created" if not vm.get("exists") else "—"))
        )
        self.row_vm_cpus.set_subtitle(str(vm.get("cpus") or "—"))
        self.row_vm_mem.set_subtitle(_fmt_size(vm.get("memory")))
        self.row_vm_disk.set_subtitle(_fmt_size(vm.get("disk")))

        if guest:
            self._levelbar_row(
                self.row_guest_mem,
                self.guest_mem_bar,
                guest.get("mem_used_bytes"),
                guest.get("mem_total_bytes"),
            )
            self._levelbar_row(
                self.row_guest_swap,
                self.guest_swap_bar,
                guest.get("swap_used_bytes"),
                guest.get("swap_total_bytes"),
            )
            self.row_squid.set_subtitle(
                "active" if guest.get("squid_active") else "inactive"
            )
        else:
            self._levelbar_row(self.row_guest_mem, self.guest_mem_bar, None, None)
            self._levelbar_row(
                self.row_guest_swap, self.guest_swap_bar, None, None
            )
            self.row_squid.set_subtitle(
                "unavailable" if status is not None else "—"
            )

        exists = bool(vm.get("exists"))
        self.btn_start.set_sensitive(not busy and exists and not vm_running)
        self.btn_stop.set_sensitive(not busy and vm_running)
        self.btn_restart.set_sensitive(not busy and vm_running)

        # Config group ---------------------------------------------------------
        path = cfg.get("path")
        self.row_cfg_file.set_subtitle(str(path or "—"))
        if not cfg.get("exists"):
            state, css = "missing", "error"
        elif not cfg.get("valid"):
            state, css = "invalid", "warning"
        else:
            state, css = "valid", "success"
        self.cfg_state_label.set_label(state)
        for cls in ("error", "warning", "success"):
            self.cfg_state_label.remove_css_class(cls)
        self.cfg_state_label.add_css_class(css)

        self.row_password.set_subtitle(
            {
                "keyring": "GNOME keyring",
                "config": "Config file (plaintext)",
                "none": "Not stored",
            }.get(cfg.get("password_source") or "", "—")
        )
        self.row_cert.set_subtitle(
            str(cert.get("fingerprint") or "None saved")
        )
        self.row_refresh.set_subtitle(self._last_refresh)

    @staticmethod
    def _proxy_row(row, button, proxy):
        if not proxy.get("enabled"):
            row.set_subtitle("disabled")
            button.set_sensitive(False)
            return
        state = "running" if proxy.get("running") else "stopped"
        row.set_subtitle("127.0.0.1:%s — %s" % (proxy.get("port"), state))
        button.set_sensitive(True)

    @staticmethod
    def _levelbar_row(row, bar, used, total):
        if total:
            row.set_subtitle("%s / %s" % (_fmt_size(used), _fmt_size(total)))
            bar.set_min_value(0)
            bar.set_max_value(float(total))
            bar.set_value(float(used or 0))
        else:
            row.set_subtitle("unavailable")
            bar.set_min_value(0)
            bar.set_max_value(1)
            bar.set_value(0)


class LogSource(GObject.Object):
    name = GObject.Property(type=str)
    kind = GObject.Property(type=str)   # "file" | "guest"
    ref = GObject.Property(type=str)    # file path or logs source name
    enabled = GObject.Property(type=bool, default=True)

    def __init__(self, name, kind, ref, enabled=True):
        super().__init__(name=name, kind=kind, ref=ref, enabled=enabled)


