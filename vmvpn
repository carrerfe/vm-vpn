#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VM_NAME="${VMVPN_VM_NAME:-vmvpn}"
VM_CONFIG="$SCRIPT_DIR/vmvpn.yaml"
VPN_CONFIG="${VPN_CONFIG:-$SCRIPT_DIR/vpn-config.json}"
CERT_FINGERPRINT_FILE="$SCRIPT_DIR/.vpn-cert-fingerprint"
FIREFOX_PROFILE_NAME="vmvpn"
START_TIMEOUT="30m"
VMVPN_VERSION="1.1.0"

COMMANDS="setup start stop restart abort settings ui vm-autostart shell ssh status delete vm-apply logs vpn-connect vpn-disconnect vpn-status password-set password-clear cert-forget firefox firefox-profile completion version"

usage() {
    echo "vmvpn - VM VPN CLI"
    echo ""
    echo "Usage: vmvpn <command> [options]"
    echo ""
    echo "VM Commands:"
    echo "  setup           Interactive first-time setup (VPN account + VM)"
    echo "  start           Create and start the VM"
    echo "  stop [-f]       Stop the VM (-f: abort running op, force stop)"
    echo "  restart         Restart the VM"
    echo "  abort           Kill a stuck vmvpn operation (and guest VPN helpers)"
    echo "  shell           Open a shell in the VM"
    echo "  ssh             Connect via SSH"
    echo "  status [--json] Show VM status (--json: machine-readable output)"
    echo "  delete [-y|-f]  Delete the VM completely (-y: skip confirmation, -f: force)"
    echo "  vm-apply [-y]   Apply the 'vm' config section to the VM (may restart it)"
    echo "  logs <source> [-n N] [-f]"
    echo "                  Guest logs: vpn, journal, squid, forticlient"
    echo "                  (default: 200 lines; -f: follow/stream)"
    echo ""
    echo "VPN Commands:"
    echo "  vpn-connect [--password-stdin] [--trust-fingerprint FP]"
    echo "                  Connect to VPN (auto-starts VM and proxies per config)"
    echo "  vpn-disconnect  Disconnect from VPN (stops proxies)"
    echo "  vpn-status      Show VPN and proxy status"
    echo "  password-set [--stdin]   Store VPN password in GNOME keyring"
    echo "  password-clear           Remove VPN password from GNOME keyring"
    echo "  cert-forget              Forget saved VPN certificate fingerprint"
    echo ""
    echo "UI Commands (the VM VPN app):"
    echo "  ui [status|logs|settings|setup]  Open the app on a page (starts the tray too)"
    echo "  ui stop         Stop the app (window + tray)"
    echo "  ui tray [on|off]                 Show/stop the tray icon"
    echo "  ui setup-prompt [on|off]         Offer setup at login until configured"
    echo "  settings                 Open the app on the Settings page"
    echo "  vm-autostart [on|off|run]        Start the VM at graphical login"
    echo ""
    echo "Browser Commands:"
    echo "  firefox         Launch Firefox with VPN proxy profile"
    echo "  firefox-profile Show Firefox profile info and deletion command"
    echo ""
    echo "Shell Completion:"
    echo "  completion bash   Output bash completion script"
    echo "  completion zsh    Output zsh completion script"
    echo ""
    echo "Other:"
    echo "  version           Print version (also --version, -V)"
    echo ""
    echo "Environment variables:"
    echo "  VPN_CONFIG        Path to VPN config JSON file (default: ./vpn-config.json)"
    echo "  VMVPN_VM_NAME     Lima VM name to manage (default: vmvpn)"
    echo "  VMVPN_SWAP_SIZE   Guest swap file size, overrides config vm.swap_mib (e.g. 4G)"
    echo "  VMVPN_SWAPPINESS  Guest vm.swappiness, overrides config vm.swappiness (e.g. 100)"
    echo ""
    echo "Exit codes:"
    echo "  0  success"
    echo "  1  general error / usage"
    echo "  2  VPN login failed"
    echo "  3  server certificate needs confirmation (non-interactive)"
    echo "  4  password required but none available (non-interactive)"
    echo "  5  VPN config file missing or invalid"
    echo "  6  another vmvpn operation is in progress (operation lock held)"
    exit 1
}

# Serialize mutating operations (start/stop/restart/delete/vpn-connect/
# vpn-disconnect): the lock file lives in XDG_RUNTIME_DIR and is held on fd 9
# for the lifetime of the process.
take_operation_lock() {
    local lock_file="${XDG_RUNTIME_DIR:-/tmp}/vmvpn-${VM_NAME}.lock"
    mkdir -p "${XDG_RUNTIME_DIR:-/tmp}"
    exec 9>"$lock_file"
    if ! flock -n 9; then
        echo "Another vmvpn operation is in progress" >&2
        exit 6
    fi
    # Record who holds the lock for 'vmvpn abort' (separate file: probing the
    # lock with `>` would truncate the lock file itself).
    printf '%s %s\n' "$$" "$*" > "${lock_file}.pid"
}

# Take the lock, then run a command in a subshell with fd 9 closed so that
# spawned processes (limactl -> hostagent -> qemu) do not inherit the lock fd
# and keep it held after this script exits.
run_locked() {
    take_operation_lock "$1"
    ( exec 9>&-; "$@" )
}

# True when the operation lock is free (no other vmvpn process holds it).
operation_lock_free() {
    local lock_file="${XDG_RUNTIME_DIR:-/tmp}/vmvpn-${VM_NAME}.lock"
    ( exec 9>"$lock_file"; flock -n 9 ) 2>/dev/null
}

# Recursively print all descendant pids of $1.
collect_descendants() {
    local child
    for child in $(ps -o pid= --ppid "$1" 2>/dev/null); do
        echo "$child"
        collect_descendants "$child"
    done
}

# Kill a stuck vmvpn operation: TERM the lock holder and its whole process
# tree, wait briefly, KILL survivors. Also kills stuck FortiClient helpers in
# the guest, which can hold FortiClient's single-instance lock.
abort() {
    local lock_file="${XDG_RUNTIME_DIR:-/tmp}/vmvpn-${VM_NAME}.lock"
    local pid_file="${lock_file}.pid"
    local killed=false

    if ! operation_lock_free && [[ -f "$pid_file" ]]; then
        local holder_pid _holder_cmd
        read -r holder_pid _holder_cmd < "$pid_file" || true
        if [[ "$holder_pid" =~ ^[0-9]+$ ]] && kill -0 "$holder_pid" 2>/dev/null \
           && tr '\0' ' ' < "/proc/$holder_pid/cmdline" 2>/dev/null | grep -q "vmvpn"; then
            local victims v
            victims=$(collect_descendants "$holder_pid")
            for v in $holder_pid $victims; do
                local vcmd
                vcmd=$(tr '\0' ' ' < "/proc/$v/cmdline" 2>/dev/null || true)
                echo "Terminating $v ${vcmd:-(process)}"
                kill -TERM "$v" 2>/dev/null || true
            done
            local waited=0
            while (( waited < 30 )); do
                local alive=false v2
                for v2 in $holder_pid $victims; do
                    if kill -0 "$v2" 2>/dev/null; then alive=true; break; fi
                done
                [[ "$alive" == "false" ]] && break
                sleep 0.1
                waited=$((waited + 1))
            done
            for v in $holder_pid $victims; do
                if kill -0 "$v" 2>/dev/null; then
                    echo "Force killing $v"
                    kill -KILL "$v" 2>/dev/null || true
                fi
            done
            killed=true
        fi
        # Wait until the lock is actually released
        waited=0
        while ! operation_lock_free && (( waited < 20 )); do
            sleep 0.1
            waited=$((waited + 1))
        done
    fi
    rm -f "$pid_file"

    # Kill stuck FortiClient helpers in the guest (VM running only).
    if command -v limactl >/dev/null 2>&1 && \
       limactl list 2>/dev/null | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { f=1 } END { exit !f }'; then
        limactl shell "$VM_NAME" -- sudo sh -c \
            'for p in fortivpn forticlient-cli expect; do
                 pkill -x "$p" 2>/dev/null && echo "Killed guest process: $p"
             done; exit 0' 2>/dev/null || true
    fi

    if [[ "$killed" == "true" ]]; then
        echo "Operation aborted."
    else
        echo "Nothing to abort."
    fi
}

check_lima() {
    if ! command -v limactl &> /dev/null; then
        echo "Error: Lima is not installed."
        echo ""
        echo "Install Lima:"
        echo "  Linux:  curl -fsSL https://lima-vm.io/install.sh | bash"
        echo "  macOS:  brew install lima"
        echo ""
        echo "See: https://lima-vm.io/"
        exit 1
    fi
}

# Phase marker for long-running operations. The GUI displays the latest
# '==> ' line as its progress text; everything else is treated as detail.
phase() {
    echo "==> $*"
}

# The UI scripts directory: vmvpn-gui/ next to an installed vmvpn, gui/ in a
# checkout. Used for spawning the UI and reading release.json.
ui_gui_dir() {
    if [[ -x "$SCRIPT_DIR/vmvpn-gui/vmvpn-window" ]]; then
        echo "$SCRIPT_DIR/vmvpn-gui"
    elif [[ -x "$SCRIPT_DIR/gui/vmvpn-window" ]]; then
        echo "$SCRIPT_DIR/gui"
    else
        return 1
    fi
}

# Installed release metadata: "<commit>, <ref>, installed <date>" from
# vmvpn-gui/release.json, or "git <describe>" in a checkout. 1 when unknown.
release_info() {
    local gui_dir="" rf=""
    gui_dir=$(ui_gui_dir 2>/dev/null || true)
    [[ -n "$gui_dir" ]] && rf="$gui_dir/release.json"
    if [[ -n "$rf" && -f "$rf" ]] && command -v jq >/dev/null 2>&1; then
        jq -r '"\(.commit // "unknown"), \(.ref // "unknown"), installed \(.installed_at // "unknown")"' \
            "$rf" 2>/dev/null && return 0
    fi
    if command -v git >/dev/null 2>&1 \
       && git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local desc
        desc=$(git -C "$SCRIPT_DIR" describe --tags --always --dirty 2>/dev/null || true)
        [[ -n "$desc" ]] && { echo "git $desc"; return 0; }
    fi
    return 1
}

# status_json release object: release.json contents, a git describe fallback
# in a checkout, or null.
release_json_value() {
    local gui_dir="" rf=""
    gui_dir=$(ui_gui_dir 2>/dev/null || true)
    [[ -n "$gui_dir" ]] && rf="$gui_dir/release.json"
    if [[ -n "$rf" && -f "$rf" ]] && command -v jq >/dev/null 2>&1; then
        jq -c '.' "$rf" 2>/dev/null && return 0
    fi
    if command -v git >/dev/null 2>&1 \
       && git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local desc ref
        desc=$(git -C "$SCRIPT_DIR" describe --tags --always --dirty 2>/dev/null || true)
        ref=$(git -C "$SCRIPT_DIR" branch --show-current 2>/dev/null || true)
        jq -nc --arg c "$desc" --arg r "$ref" --arg s "git" \
            '{version: null, commit: $c, ref: $r, source: $s, installed_at: null}' \
            && return 0
    fi
    echo "null"
}

check_jq() {
    if ! command -v jq &> /dev/null; then
        echo "Error: jq is not installed (required to parse VPN config)."
        echo ""
        echo "Install jq:"
        echo "  Ubuntu/Debian: sudo apt install jq"
        echo "  macOS:         brew install jq"
        exit 1
    fi
}

# Effective VM resources. The optional "vm" object in vpn-config.json manages
# each resource independently: a key that is absent or null is UNMANAGED (the
# instance/template keeps whatever it has; empty VM_CFG_*). VMVPN_SWAP_SIZE /
# VMVPN_SWAPPINESS count as set for the swap values. read_vm_config only fills
# the globals (safe in status_json); validate_vm_config exits on bad values.
VM_CFG_CPUS=""
VM_CFG_MEMORY_MIB=""
VM_CFG_DISK_GIB=""
VM_CFG_SWAP_MIB=""
VM_CFG_SWAPPINESS=""

read_vm_config() {
    VM_CFG_CPUS=""; VM_CFG_MEMORY_MIB=""; VM_CFG_DISK_GIB=""
    VM_CFG_SWAP_MIB=""; VM_CFG_SWAPPINESS=""
    if [[ -f "$VPN_CONFIG" ]] && command -v jq >/dev/null 2>&1 \
       && jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        # One value per line (empty = unset): mapfile keeps empty fields,
        # which a tab-separated `read` would collapse.
        local -a vals=()
        mapfile -t vals < <(jq -r '(.vm | if type == "object" then . else {} end) |
            [.cpus, .memory_mib, .disk_gib, .swap_mib, .swappiness] |
            map(if . == null then "" else tostring end) | .[]' "$VPN_CONFIG" 2>/dev/null)
        if [[ ${#vals[@]} -eq 5 ]]; then
            VM_CFG_CPUS="${vals[0]}"; VM_CFG_MEMORY_MIB="${vals[1]}"
            VM_CFG_DISK_GIB="${vals[2]}"; VM_CFG_SWAP_MIB="${vals[3]}"
            VM_CFG_SWAPPINESS="${vals[4]}"
        fi
    fi
    if [[ -n "${VMVPN_SWAP_SIZE:-}" ]]; then
        if [[ "$VMVPN_SWAP_SIZE" =~ ^[1-9][0-9]*[KMG]?$ ]]; then
            case "$VMVPN_SWAP_SIZE" in
                *G) VM_CFG_SWAP_MIB=$(( ${VMVPN_SWAP_SIZE%G} * 1024 )) ;;
                *M) VM_CFG_SWAP_MIB=$(( 10#${VMVPN_SWAP_SIZE%M} )) ;;
                *K) VM_CFG_SWAP_MIB=$(( 10#${VMVPN_SWAP_SIZE%K} / 1024 )) ;;
                *)  VM_CFG_SWAP_MIB=$(( 10#$VMVPN_SWAP_SIZE / 1048576 )) ;;
            esac
        else
            echo "Warning: invalid VMVPN_SWAP_SIZE '$VMVPN_SWAP_SIZE'; ignoring." >&2
        fi
    fi
    if [[ -n "${VMVPN_SWAPPINESS:-}" ]]; then
        VM_CFG_SWAPPINESS="$VMVPN_SWAPPINESS"
    fi
}

validate_vm_config() {
    read_vm_config
    local ncpu mem_total_mib
    ncpu=$(nproc 2>/dev/null || echo 1)
    mem_total_mib=$(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    [[ -n "$mem_total_mib" && "$mem_total_mib" =~ ^[0-9]+$ ]] || mem_total_mib=0
    if [[ -n "$VM_CFG_CPUS" ]] && \
       { [[ ! "$VM_CFG_CPUS" =~ ^[0-9]+$ ]] || (( 10#$VM_CFG_CPUS < 1 || 10#$VM_CFG_CPUS > ncpu )); }; then
        echo "Error: vm.cpus must be an integer between 1 and $ncpu" >&2; exit 5
    fi
    if [[ -n "$VM_CFG_MEMORY_MIB" ]] && \
       { [[ ! "$VM_CFG_MEMORY_MIB" =~ ^[0-9]+$ ]] || \
         (( 10#$VM_CFG_MEMORY_MIB < 256 || ( mem_total_mib > 0 && 10#$VM_CFG_MEMORY_MIB > mem_total_mib ) )); }; then
        echo "Error: vm.memory_mib must be an integer between 256 and ${mem_total_mib:-<host RAM MiB>}" >&2; exit 5
    fi
    if [[ -n "$VM_CFG_DISK_GIB" ]] && \
       { [[ ! "$VM_CFG_DISK_GIB" =~ ^[0-9]+$ ]] || (( 10#$VM_CFG_DISK_GIB < 5 || 10#$VM_CFG_DISK_GIB > 2048 )); }; then
        echo "Error: vm.disk_gib must be an integer between 5 and 2048" >&2; exit 5
    fi
    if [[ -n "$VM_CFG_SWAP_MIB" ]] && \
       { [[ ! "$VM_CFG_SWAP_MIB" =~ ^[0-9]+$ ]] || (( 10#$VM_CFG_SWAP_MIB > 65536 )); }; then
        echo "Error: vm.swap_mib must be an integer between 0 and 65536" >&2; exit 5
    fi
    if [[ -n "$VM_CFG_SWAPPINESS" ]] && \
       { [[ ! "$VM_CFG_SWAPPINESS" =~ ^[0-9]+$ ]] || (( 10#$VM_CFG_SWAPPINESS > 200 )); }; then
        echo "Error: vm.swappiness must be null or an integer between 0 and 200" >&2; exit 5
    fi
    [[ -n "$VM_CFG_CPUS" ]] && VM_CFG_CPUS=$((10#$VM_CFG_CPUS))
    [[ -n "$VM_CFG_MEMORY_MIB" ]] && VM_CFG_MEMORY_MIB=$((10#$VM_CFG_MEMORY_MIB))
    [[ -n "$VM_CFG_DISK_GIB" ]] && VM_CFG_DISK_GIB=$((10#$VM_CFG_DISK_GIB))
    [[ -n "$VM_CFG_SWAP_MIB" ]] && VM_CFG_SWAP_MIB=$((10#$VM_CFG_SWAP_MIB))
    return 0
}

# Idempotently apply the configured guest swap and swappiness. One guest call.
apply_guest_swap() {
    limactl list 2>/dev/null | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { f=1 } END { exit !f }' \
        || return 0
    read_vm_config
    limactl shell "$VM_NAME" -- sudo sh -c '
        SWAP_MIB="$1"; SWAPPINESS="$2"
        if [ -n "$SWAP_MIB" ] && [ "$SWAP_MIB" = "0" ]; then
            if grep -q "^/swapfile " /proc/swaps 2>/dev/null; then
                if ! swapoff /swapfile; then
                    echo "Error: swapoff failed (memory pressure); leaving existing swap." >&2
                    exit 1
                fi
            fi
            rm -f /swapfile
            sed -i "\|^/swapfile |d" /etc/fstab 2>/dev/null || true
        elif [ -n "$SWAP_MIB" ]; then
            cur=$(awk "\$1 == \"/swapfile\" { print \$3 }" /proc/swaps 2>/dev/null)
            want_kib=$((SWAP_MIB * 1024))
            if [ ! -f /swapfile ] || [ "$cur" != "$want_kib" ]; then
                if grep -q "^/swapfile " /proc/swaps 2>/dev/null \
                   && ! swapoff /swapfile; then
                    echo "Error: swapoff failed (memory pressure); cannot resize swap." >&2
                    exit 1
                fi
                rm -f /swapfile
                fallocate -l "${SWAP_MIB}M" /swapfile || exit 1
                chmod 600 /swapfile
                mkswap /swapfile >/dev/null || exit 1
                swapon /swapfile || exit 1
            fi
            grep -q "^/swapfile " /etc/fstab 2>/dev/null \
                || echo "/swapfile none swap sw 0 0" >> /etc/fstab
        fi
        if [ -n "$SWAPPINESS" ]; then
            sysctl -w "vm.swappiness=$SWAPPINESS" >/dev/null || exit 1
            echo "vm.swappiness=$SWAPPINESS" > /etc/sysctl.d/99-vmvpn-swap.conf
        fi
    ' _ "$VM_CFG_SWAP_MIB" "$VM_CFG_SWAPPINESS"
}

create_vm() {
    validate_vm_config
    local args=(--name="$VM_NAME" --timeout="$START_TIMEOUT")
    [[ -n "$VM_CFG_CPUS" ]] && args+=(--cpus "$VM_CFG_CPUS")
    if [[ -n "$VM_CFG_MEMORY_MIB" ]]; then
        local mem_gib
        mem_gib=$(awk -v m="$VM_CFG_MEMORY_MIB" 'BEGIN{printf "%g", m/1024}')
        args+=(--memory "$mem_gib")
    fi
    [[ -n "$VM_CFG_DISK_GIB" ]] && args+=(--disk "$VM_CFG_DISK_GIB")
    args+=(--tty=false)
    if [[ -n "${VMVPN_SWAP_SIZE:-}" ]]; then
        args+=(--set ".param.SWAP_SIZE = \"$VMVPN_SWAP_SIZE\"")
    fi
    if [[ -n "${VMVPN_SWAPPINESS:-}" ]]; then
        args+=(--set ".param.SWAPPINESS = \"$VMVPN_SWAPPINESS\"")
    fi
    limactl start "${args[@]}" "$VM_CONFIG"
}

start() {
    check_lima
    check_vpn_config
    if limactl list -q | grep -q "^${VM_NAME}$"; then
        phase "Starting the VM…"
        limactl start --timeout="$START_TIMEOUT" "$VM_NAME"
    else
        phase "Creating the VM (first time only: downloads Ubuntu and installs FortiClient, usually 5–15 minutes)…"
        create_vm
        phase "Waiting for the VM to become ready…"
    fi
    apply_guest_swap || echo "Warning: could not apply guest swap settings." >&2
    echo ""
    echo "VM is ready. Use '$0 shell' to access it."
}

vm_stop() {
    check_lima
    local force="${1:-}"
    echo "Stopping VM..."
    if [[ "$force" == "force" ]]; then
        limactl stop -f "$VM_NAME" 2>/dev/null || echo "VM is not running."
    else
        limactl stop "$VM_NAME" 2>/dev/null || echo "VM is not running."
    fi
}

stop() {
    local force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force) force=true ;;
            *) echo "Error: unknown option for stop: $1" >&2; exit 1 ;;
        esac
        shift
    done
    if [[ "$force" == "true" ]]; then
        abort
        run_locked vm_stop force
    else
        run_locked vm_stop
    fi
}

restart() {
    vm_stop
    start
}

# Apply the "vm" config section to an existing VM. CPUs/memory/disk changes
# need a restart; swap/swappiness are applied live in the guest.
vm_apply() {
    local assume_yes=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes) assume_yes=true ;;
            *) echo "Error: unknown option for vm-apply: $1" >&2; exit 1 ;;
        esac
        shift
    done

    check_lima
    check_jq
    validate_vm_config

    local inst
    inst=$(limactl list --json 2>/dev/null | jq -c --arg n "$VM_NAME" 'select(.name == $n)' | head -n 1)
    if [[ -z "$inst" ]]; then
        echo "Error: VM '$VM_NAME' does not exist. Run 'vmvpn start' first." >&2
        exit 1
    fi

    local inst_cpus inst_mem_mib inst_disk_gib inst_status
    inst_cpus=$(jq -r '.cpus // 0' <<<"$inst")
    inst_mem_mib=$(jq -r '((.memory // 0) / 1048576) | round' <<<"$inst")
    inst_disk_gib=$(jq -r '((.disk // 0) / 1073741824) | round' <<<"$inst")
    inst_status=$(jq -r '.status // "Unknown"' <<<"$inst")

    if [[ -n "$VM_CFG_DISK_GIB" ]] && (( VM_CFG_DISK_GIB < inst_disk_gib )); then
        echo "Error: disk cannot shrink (configured ${VM_CFG_DISK_GIB}GiB < current ${inst_disk_gib}GiB)." >&2
        exit 1
    fi

    # Only keys set in the config are managed; unset keys keep the instance's
    # current value and never trigger a restart.
    local needs_restart=false
    [[ -n "$VM_CFG_CPUS" && "$VM_CFG_CPUS" != "$inst_cpus" ]] && needs_restart=true
    [[ -n "$VM_CFG_MEMORY_MIB" && "$VM_CFG_MEMORY_MIB" != "$inst_mem_mib" ]] && needs_restart=true
    [[ -n "$VM_CFG_DISK_GIB" && "$VM_CFG_DISK_GIB" != "$inst_disk_gib" ]] && needs_restart=true

    if [[ "$needs_restart" == "true" ]]; then
        if [[ "$assume_yes" != "true" && ! -t 0 ]]; then
            echo "Error: applying cpus/memory/disk requires a VM restart; re-run with -y." >&2
            exit 1
        fi
        if [[ "$assume_yes" != "true" ]]; then
            read -p "The VM will restart and the VPN will disconnect. Continue? [y/N] " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Cancelled."
                return 0
            fi
        fi
        local was_running=false
        [[ "$inst_status" == "Running" ]] && was_running=true
        if [[ "$was_running" == "true" ]]; then
            if limactl shell "$VM_NAME" -- timeout -k 5 30 \
                /opt/forticlient/forticlient-cli vpn status 2>/dev/null | grep -q "Status: Connected"; then
                echo "Disconnecting VPN..."
                if [[ -f "$VPN_CONFIG" ]]; then
                    vpn_disconnect
                else
                    limactl shell "$VM_NAME" -- timeout -k 5 30 \
                        /opt/forticlient/forticlient-cli vpn disconnect 2>/dev/null || true
                fi
            fi
            vm_stop
        fi
        phase "Applying VM settings (the VM will restart)…"
        local edit_args=(--tty=false) desc=()
        if [[ -n "$VM_CFG_CPUS" ]]; then
            edit_args+=(--cpus "$VM_CFG_CPUS"); desc+=("cpus=$VM_CFG_CPUS")
        fi
        if [[ -n "$VM_CFG_MEMORY_MIB" ]]; then
            local mem_gib
            mem_gib=$(awk -v m="$VM_CFG_MEMORY_MIB" 'BEGIN{printf "%g", m/1024}')
            edit_args+=(--memory "$mem_gib"); desc+=("memory=${VM_CFG_MEMORY_MIB}MiB")
        fi
        if [[ -n "$VM_CFG_DISK_GIB" ]]; then
            edit_args+=(--disk "$VM_CFG_DISK_GIB"); desc+=("disk=${VM_CFG_DISK_GIB}GiB")
        fi
        echo "Applying VM resources (${desc[*]})..."
        limactl edit "${edit_args[@]}" "$VM_NAME"
        if [[ "$was_running" == "true" ]]; then
            echo "Starting VM..."
            limactl start --timeout="$START_TIMEOUT" "$VM_NAME"
        fi
    else
        echo "VM resources already match the config."
    fi

    apply_guest_swap || echo "Warning: could not apply guest swap settings." >&2
    echo "Done."
}

shell() {
    check_lima
    limactl shell "$VM_NAME"
}

ssh_connect() {
    check_lima
    ssh -F ~/.lima/"$VM_NAME"/ssh.config lima-"$VM_NAME"
}

status() {
    check_lima
    echo "VM status:"
    limactl list | grep -E "^NAME|^${VM_NAME}"
    echo ""
    if limactl list -q | grep -q "^${VM_NAME}$"; then
        echo "VM info:"
        limactl info "$VM_NAME" 2>/dev/null || true
    fi
}

# Machine-readable status for scripting/GUI. Always exits 0, even when the VM
# or the config file is missing (reported via exists/valid flags).
status_json() {
    check_jq
    read_vm_config

    # --- Operation lock state (some other vmvpn command is acting) ---
    local busy=false
    if ! operation_lock_free; then
        busy=true
    fi

    # --- VM (from `limactl list --json`, one object per line) ---
    local vm_json="" vm_obj
    if command -v limactl >/dev/null 2>&1; then
        vm_json=$(limactl list --json 2>/dev/null | jq -c --arg n "$VM_NAME" 'select(.name == $n)' 2>/dev/null | head -n 1) || vm_json=""
    fi
    if [[ -n "$vm_json" ]]; then
        vm_obj=$(jq -c '{
            name: .name,
            exists: true,
            status: (.status // "Unknown"),
            dir: (.dir // null),
            cpus: (.cpus // null),
            memory_bytes: (.memory // null),
            disk_bytes: (.disk // null)
        }' <<<"$vm_json")
    else
        vm_obj=$(jq -nc --arg n "$VM_NAME" '{
            name: $n, exists: false, status: "NotCreated",
            dir: null, cpus: null, memory_bytes: null, disk_bytes: null
        }')
    fi
    local vm_running=false
    [[ $(jq -r '.status' <<<"$vm_obj") == "Running" ]] && vm_running=true

    # --- Pending restart: a managed cpus/memory/disk key differs from the
    # instance. Unset (unmanaged) keys never count. ---
    local vm_pending_restart=false
    if [[ -n "$vm_json" ]]; then
        local i_cpus i_mem i_disk
        i_cpus=$(jq -r '.cpus // empty' <<<"$vm_json")
        i_mem=$(jq -r '.memory // empty' <<<"$vm_json")
        i_disk=$(jq -r '.disk // empty' <<<"$vm_json")
        if [[ -n "$VM_CFG_CPUS" && "$i_cpus" =~ ^[0-9]+$ ]] \
           && (( i_cpus != 10#$VM_CFG_CPUS )); then
            vm_pending_restart=true
        fi
        if [[ -n "$VM_CFG_MEMORY_MIB" && "$i_mem" =~ ^[0-9]+$ ]] \
           && (( i_mem != 10#$VM_CFG_MEMORY_MIB * 1048576 )); then
            vm_pending_restart=true
        fi
        if [[ -n "$VM_CFG_DISK_GIB" && "$i_disk" =~ ^[0-9]+$ ]] \
           && (( i_disk != 10#$VM_CFG_DISK_GIB * 1073741824 )); then
            vm_pending_restart=true
        fi
    fi
    local vm_cfg_json
    vm_cfg_json=$(jq -nc \
        --arg c "$VM_CFG_CPUS" --arg m "$VM_CFG_MEMORY_MIB" \
        --arg d "$VM_CFG_DISK_GIB" --arg s "$VM_CFG_SWAP_MIB" \
        --arg sw "$VM_CFG_SWAPPINESS" \
        '{cpus: (if $c == "" then null else ($c | tonumber? // null) end),
          memory_mib: (if $m == "" then null else ($m | tonumber? // null) end),
          disk_gib: (if $d == "" then null else ($d | tonumber? // null) end),
          swap_mib: (if $s == "" then null else ($s | tonumber? // null) end),
          swappiness: (if $sw == "" then null else ($sw | tonumber? // null) end)}')

    # --- Guest: one shell call for VPN status, memory and squid, split by markers ---
    local guest_json="null" squid_active=false
    local vpn_state="disconnected" vpn_raw=""
    if [[ "$vm_running" == "true" ]]; then
        local guest_out="" guest_rc=0
        guest_out=$(limactl shell "$VM_NAME" -- sh -c '
            echo ::VMVPN_VPN_STATUS::
            timeout -k 5 15 /opt/forticlient/forticlient-cli vpn status 2>&1 || true
            echo ::VMVPN_FREE::
            free -b 2>/dev/null || true
            echo ::VMVPN_SQUID::
            systemctl is-active squid 2>/dev/null || true
            exit 0
        ' 2>/dev/null) || guest_rc=$?
        if [[ $guest_rc -ne 0 ]]; then
            vpn_state="unknown"
        else
            vpn_raw=$(awk '/^::VMVPN_VPN_STATUS::$/{f=1;next}/^::VMVPN_FREE::$/{f=0}f' <<<"$guest_out")
            local free_out squid_state
            free_out=$(awk '/^::VMVPN_FREE::$/{f=1;next}/^::VMVPN_SQUID::$/{f=0}f' <<<"$guest_out")
            squid_state=$(awk '/^::VMVPN_SQUID::$/{f=1;next}f' <<<"$guest_out" | head -n 1)
            [[ "$squid_state" == "active" ]] && squid_active=true
            if grep -q "Status: Connected" <<<"$vpn_raw"; then
                vpn_state="connected"
            else
                vpn_state="disconnected"
            fi
            local mem_total mem_used mem_avail swap_total swap_used
            mem_total=$(awk '/^Mem:/{print $2}' <<<"$free_out")
            mem_used=$(awk '/^Mem:/{print $3}' <<<"$free_out")
            mem_avail=$(awk '/^Mem:/{print $7}' <<<"$free_out")
            swap_total=$(awk '/^Swap:/{print $2}' <<<"$free_out")
            swap_used=$(awk '/^Swap:/{print $3}' <<<"$free_out")
            guest_json=$(jq -nc \
                --argjson mt "${mem_total:-0}" --argjson mu "${mem_used:-0}" \
                --argjson ma "${mem_avail:-0}" --argjson st "${swap_total:-0}" \
                --argjson su "${swap_used:-0}" --argjson sq "$squid_active" \
                '{mem_total_bytes:$mt, mem_used_bytes:$mu, mem_available_bytes:$ma,
                  swap_total_bytes:$st, swap_used_bytes:$su, squid_active:$sq}')
        fi
    fi

    # --- Config (never fatal here) ---
    local cfg_exists=false cfg_valid=false cfg_reason="missing"
    local cfg_gateway="" cfg_port="" cfg_username=""
    local password_source="none"
    local socks_enabled=true socks_port=1080 http_enabled=false http_port=3128
    if [[ -f "$VPN_CONFIG" ]] && jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        cfg_exists=true
        socks_enabled=$(jq -r '.socks_proxy.enabled // true' "$VPN_CONFIG")
        socks_port=$(jq -r '.socks_proxy.port // 1080' "$VPN_CONFIG")
        http_enabled=$(jq -r '.http_proxy.enabled // false' "$VPN_CONFIG")
        http_port=$(jq -r '.http_proxy.port // 3128' "$VPN_CONFIG")
        cfg_gateway=$(jq -r '.gateway // empty' "$VPN_CONFIG")
        cfg_port=$(jq -r '.port // 443' "$VPN_CONFIG")
        cfg_username=$(jq -r '.username // empty' "$VPN_CONFIG")
        local cfg_password
        cfg_password=$(jq -r '.password // empty' "$VPN_CONFIG")
        [[ "$cfg_gateway" == "null" ]] && cfg_gateway=""
        [[ "$cfg_username" == "null" ]] && cfg_username=""
        if _is_example_placeholder "$cfg_gateway" \
           || _is_example_placeholder "$cfg_username"; then
            cfg_reason="placeholder values"
        elif [[ -z "$cfg_gateway" || -z "$cfg_username" ]]; then
            cfg_reason="incomplete"
        else
            cfg_valid=true
            cfg_reason=""
            if [[ -n "$cfg_password" && "$cfg_password" != "null" ]]; then
                password_source="config"
            elif command -v secret-tool >/dev/null 2>&1 && \
                 [[ -n $(timeout 5 secret-tool search service vmvpn gateway "$cfg_gateway" username "$cfg_username" 2>/dev/null) ]]; then
                password_source="keyring"
            fi
        fi
    elif [[ -f "$VPN_CONFIG" ]]; then
        cfg_exists=true
        cfg_reason="invalid JSON"
    fi
    [[ "$socks_enabled" == "true" || "$socks_enabled" == "false" ]] || socks_enabled=true
    [[ "$http_enabled" == "true" || "$http_enabled" == "false" ]] || http_enabled=false
    [[ "$socks_port" =~ ^[0-9]+$ ]] || socks_port=1080
    [[ "$http_port" =~ ^[0-9]+$ ]] || http_port=3128

    # --- Proxies ---
    local socks_running=false http_running=false
    if pgrep -f "ssh.*-D.*127.0.0.1:${socks_port}.*lima-${VM_NAME}" >/dev/null 2>&1; then
        socks_running=true
    fi
    if [[ "$http_enabled" == "true" && "$squid_active" == "true" ]]; then
        http_running=true
    fi

    # --- Saved certificate fingerprint ---
    local cert_fp=""
    if [[ -f "$CERT_FINGERPRINT_FILE" ]]; then
        cert_fp=$(cat "$CERT_FINGERPRINT_FILE")
    fi

    # --- UI processes / preferences ---
    local ui_tray_enabled=false ui_tray_running=false ui_window_running=false
    local ui_setup_prompt=false vm_autostart=false
    ui_pref_get tray true && ui_tray_enabled=true
    ui_pref_get setup_prompt true && ui_setup_prompt=true
    ui_process_running "$UI_TRAY_BUS" && ui_tray_running=true
    ui_process_running "$UI_WINDOW_BUS" && ui_window_running=true
    [[ -f "$VM_AUTOSTART_FILE" ]] && vm_autostart=true
    local ui_json
    ui_json=$(jq -nc \
        --argjson te "$ui_tray_enabled" --argjson tr "$ui_tray_running" \
        --argjson wr "$ui_window_running" --argjson sp "$ui_setup_prompt" \
        '{tray_enabled: $te, tray_running: $tr, window_running: $wr,
          setup_prompt: $sp}')
    local release_json
    release_json=$(release_json_value)

    jq -n \
        --arg ver "$VMVPN_VERSION" \
        --argjson busy "$busy" \
        --argjson vm "$vm_obj" \
        --argjson vmConfig "$vm_cfg_json" \
        --argjson vmPendingRestart "$vm_pending_restart" \
        --argjson guest "$guest_json" \
        --arg vpnState "$vpn_state" \
        --arg vpnRaw "$vpn_raw" \
        --argjson socksEnabled "$socks_enabled" \
        --argjson socksPort "$socks_port" \
        --argjson socksRunning "$socks_running" \
        --argjson httpEnabled "$http_enabled" \
        --argjson httpPort "$http_port" \
        --argjson httpRunning "$http_running" \
        --arg cfgPath "$VPN_CONFIG" \
        --argjson cfgExists "$cfg_exists" \
        --argjson cfgValid "$cfg_valid" \
        --arg cfgReason "$cfg_reason" \
        --arg cfgGateway "$cfg_gateway" \
        --arg cfgPort "$cfg_port" \
        --arg cfgUsername "$cfg_username" \
        --arg pwSource "$password_source" \
        --arg certPath "$CERT_FINGERPRINT_FILE" \
        --arg certFp "$cert_fp" \
        --argjson ui "$ui_json" \
        --argjson vmAutostart "$vm_autostart" \
        --argjson release "$release_json" \
        '{
            schema: 1,
            version: $ver,
            busy: $busy,
            vm: $vm,
            vm_config: $vmConfig,
            vm_pending_restart: $vmPendingRestart,
            guest: $guest,
            vpn: {state: $vpnState, raw: $vpnRaw},
            proxies: {
                socks: {enabled: $socksEnabled, port: $socksPort, running: $socksRunning},
                http:  {enabled: $httpEnabled, port: $httpPort, running: $httpRunning}
            },
            config: {
                path: $cfgPath,
                exists: $cfgExists,
                valid: $cfgValid,
                reason: (if $cfgReason == "" then null else $cfgReason end),
                gateway: (if $cfgValid then $cfgGateway else null end),
                port: (if $cfgValid then ($cfgPort | tonumber? // null) else null end),
                username: (if $cfgValid then $cfgUsername else null end),
                password_source: $pwSource
            },
            cert: {
                path: $certPath,
                fingerprint: (if $certFp == "" then null else $certFp end)
            },
            ui: $ui,
            vm_autostart: $vmAutostart,
            release: $release
        }'
}

delete() {
    local assume_yes=false force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes) assume_yes=true ;;
            -f|--force) force=true; assume_yes=true ;;
            *) echo "Error: unknown option for delete: $1" >&2; exit 1 ;;
        esac
        shift
    done

    [[ "$force" == "true" ]] && abort
    run_locked delete_impl "$assume_yes"
}

delete_impl() {
    local assume_yes="$1"
    check_lima
    if [[ "$assume_yes" != "true" && ! -t 0 ]]; then
        echo "Error: cannot confirm deletion non-interactively. Re-run with -y to proceed." >&2
        exit 1
    fi
    echo "This will delete the VM and all its data."
    if [[ "$assume_yes" != "true" ]]; then
        read -p "Are you sure? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            return 0
        fi
    fi
    limactl delete -f "$VM_NAME" 2>/dev/null || echo "VM does not exist."
    # The VM is gone — drop the login autostart for it too.
    rm -f "$VM_AUTOSTART_FILE"
    echo "VM deleted."
}

# Example values shipped in vpn-config.json.example. A config still
# carrying them counts as "not set up" everywhere (CLI, status, GUI).
_is_example_placeholder() {
    [[ "$1" == "vpn.example.com" || "$1" == "your-username" ]]
}

# True when the config exists, is a JSON object, and has no example
# placeholder values left in gateway/username.
vpn_config_usable() {
    [[ -f "$VPN_CONFIG" ]] || return 1
    command -v jq >/dev/null 2>&1 || return 1
    jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1 || return 1
    ! _is_example_placeholder "$(jq -r '.gateway // empty' "$VPN_CONFIG")" \
        && ! _is_example_placeholder "$(jq -r '.username // empty' "$VPN_CONFIG")"
}

check_vpn_config() {
    local problem=""
    if [[ ! -f "$VPN_CONFIG" ]]; then
        problem="missing"
    elif command -v jq >/dev/null 2>&1 && ! jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        problem="invalid"
    elif ! vpn_config_usable; then
        problem="placeholder"
    fi
    [[ -z "$problem" ]] && return 0

    if [[ -t 0 ]]; then
        case "$problem" in
            missing)
                echo "No VPN profile is set up yet." ;;
            invalid)
                echo "The VPN config file is not valid JSON: $VPN_CONFIG" ;;
            placeholder)
                echo "The VPN config still has the example values; it isn't usable yet." ;;
        esac
        local response=""
        read -r -p "Run setup now? [Y/n] " response || response="n"
        if [[ -z "$response" || "$response" =~ ^[Yy] ]]; then
            setup
            if vpn_config_usable; then
                return 0
            fi
        fi
    fi

    case "$problem" in
        missing)
            echo "Error: VPN config file not found: $VPN_CONFIG" >&2
            echo "Run 'vmvpn setup' in a terminal, or open the VM VPN app." >&2 ;;
        invalid)
            echo "Error: VPN config file is not valid JSON: $VPN_CONFIG" >&2
            echo "Fix it, or run 'vmvpn setup' to reconfigure." >&2 ;;
        placeholder)
            echo "Error: the VPN config still has the example placeholder values: $VPN_CONFIG" >&2
            echo "Run 'vmvpn setup' to enter your real VPN account." >&2 ;;
    esac
    exit 5
}

# Interactive first-time setup: VPN account + proxies, then optionally the
# VM and a first connection. Preserves unknown keys in an existing config.
setup() {
    if [[ ! -t 0 ]]; then
        echo "Error: 'vmvpn setup' is interactive — run it in a terminal, or use the VM VPN app." >&2
        exit 1
    fi
    check_jq
    echo "VM VPN setup"
    echo "============"
    echo ""
    echo "This configures your VPN account (server, username, password) and"
    echo "then creates the VM that runs the VPN client."
    echo ""

    local cur_gateway="" cur_port="" cur_username=""
    if [[ -f "$VPN_CONFIG" ]] && jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        cur_gateway=$(jq -r '.gateway // empty' "$VPN_CONFIG")
        cur_port=$(jq -r '.port // empty' "$VPN_CONFIG")
        cur_username=$(jq -r '.username // empty' "$VPN_CONFIG")
        # Example placeholder values are not real defaults.
        _is_example_placeholder "$cur_gateway" && cur_gateway=""
        _is_example_placeholder "$cur_username" && cur_username=""
    fi

    # --- VPN server (accepts host, host:port, or a https:// URL) ---
    local server_input="" gateway="" parsed_port=""
    while true; do
        local gprompt="VPN server"
        [[ -n "$cur_gateway" ]] && gprompt="$gprompt [$cur_gateway]"
        read -r -p "$gprompt: " server_input
        [[ -z "$server_input" ]] && server_input="$cur_gateway"
        local s="$server_input"
        s="${s#*://}"          # strip scheme
        s="${s%%/*}"           # strip path
        s="${s##*@}"           # strip userinfo
        gateway="$s"; parsed_port=""
        if [[ "$s" == *:* && "$s" != *:*:* ]]; then
            gateway="${s%%:*}"
            parsed_port="${s##*:}"
        fi
        if [[ -z "$gateway" || "$gateway" =~ [[:space:]] ]]; then
            echo "Please enter a server name, e.g. vpn.example.com."
            continue
        fi
        if [[ -n "$parsed_port" && ! "$parsed_port" =~ ^[0-9]+$ ]]; then
            echo "Invalid port '$parsed_port'."
            continue
        fi
        break
    done

    # --- port ---
    local port="" def_port="${parsed_port:-${cur_port:-443}}"
    read -r -p "Port [$def_port]: " port
    [[ -z "$port" ]] && port="$def_port"
    while ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); do
        read -r -p "Invalid port. Port [$def_port]: " port
        [[ -z "$port" ]] && port="$def_port"
    done

    # --- username ---
    local username="" uprompt="Username"
    [[ -n "$cur_username" ]] && uprompt="$uprompt [$cur_username]"
    while [[ -z "$username" ]]; do
        read -r -p "$uprompt: " username
        [[ -z "$username" ]] && username="$cur_username"
        [[ -z "$username" ]] && echo "Username is required."
    done

    # --- password ---
    local password="" save_in_config=false save_in_keyring=false
    read -r -s -p "Password (leave empty to be asked at each connect): " password
    echo ""
    if [[ -n "$password" ]]; then
        if command -v secret-tool >/dev/null 2>&1; then
            save_in_keyring=true
        else
            local rsp=""
            read -r -p "GNOME Keyring is not available. Save the password in the config file (plain text)? [y/N] " rsp
            if [[ "$rsp" =~ ^[Yy] ]]; then
                save_in_config=true
            else
                password=""
                echo "OK — the password will be asked at each connect."
            fi
        fi
    fi

    # --- SOCKS proxy on the first free port from 1080 ---
    local socks_port=1080
    while ! _port_is_free "$socks_port"; do
        socks_port=$((socks_port + 1))
    done
    if [[ "$socks_port" != "1080" ]]; then
        echo "Note: port 1080 is in use; the SOCKS proxy will use $socks_port."
    fi

    # --- write the config (merge into the existing file: unknown keys kept) ---
    local tmp
    tmp=$(mktemp) || exit 1
    chmod 600 "$tmp"
    local want_plaintext=false drop_password=false
    [[ "$save_in_config" == "true" ]] && want_plaintext=true
    [[ -n "$password" && "$save_in_config" == "false" ]] && drop_password=true
    local jqfilter='
        (. // {}) |
        .gateway = $gw | .port = $port | .username = $user |
        .socks_proxy = ((.socks_proxy // {}) + {enabled: true, port: $sp, auto_start: true, auto_stop: true}) |
        .http_proxy = ((.http_proxy // {}) + {enabled: false}) |
        (if $save_pw then .password = $pw
         elif $drop_pw then del(.password)
         else . end)'
    if [[ -f "$VPN_CONFIG" ]] && jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        jq --arg gw "$gateway" --argjson port "$port" --argjson sp "$socks_port" \
           --arg user "$username" --arg pw "$password" \
           --argjson save_pw "$want_plaintext" --argjson drop_pw "$drop_password" \
           "$jqfilter" "$VPN_CONFIG" > "$tmp"
    else
        jq -n --arg gw "$gateway" --argjson port "$port" --argjson sp "$socks_port" \
           --arg user "$username" --arg pw "$password" \
           --argjson save_pw "$want_plaintext" --argjson drop_pw "$drop_password" \
           "$jqfilter" > "$tmp"
    fi \
        || { rm -f "$tmp"; echo "Error: could not write the config." >&2; exit 1; }
    mv "$tmp" "$VPN_CONFIG"
    chmod 600 "$VPN_CONFIG"
    echo ""
    echo "Config written to $VPN_CONFIG"

    if [[ "$save_in_keyring" == "true" ]]; then
        if printf '%s' "$password" | password_set --stdin >/dev/null; then
            echo "Password stored in GNOME keyring."
        else
            echo "Warning: could not store the password in the keyring; it will be asked at each connect." >&2
        fi
    fi

    # --- create the VM ---
    if limactl list -q 2>/dev/null | grep -q "^${VM_NAME}$"; then
        echo ""
        echo "The VM '$VM_NAME' already exists."
    else
        echo ""
        local rsp=""
        read -r -p "Create the VM now? It downloads about 600 MB and takes 5–15 minutes, once. [Y/n] " rsp
        if [[ -z "$rsp" || "$rsp" =~ ^[Yy] ]]; then
            run_locked start || {
                echo ""
                echo "VM creation failed. You can retry with: vmvpn start" >&2
                exit 1
            }
        else
            echo ""
            echo "OK — create it later with: vmvpn start"
        fi
    fi

    # --- connect ---
    echo ""
    local connect_state="skipped"   # skipped | connected | failed
    local rsp=""
    read -r -p "Connect now? [Y/n] " rsp
    if [[ -z "$rsp" || "$rsp" =~ ^[Yy] ]]; then
        if limactl list 2>/dev/null | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { f=1 } END { exit !f }'; then
            if run_locked vpn_connect; then
                connect_state="connected"
            else
                connect_state="failed"
            fi
        else
            echo "The VM is not running; start it first with: vmvpn start"
        fi
    fi

    echo ""
    case "$connect_state" in
        connected)
            echo "Connected! Browse through the VPN with: vmvpn firefox"
            ;;
        failed)
            echo "The VPN connection failed (see the message above). To fix the"
            echo "server or account, run 'vmvpn setup' again, then 'vmvpn vpn-connect'."
            ;;
        *)
            echo "Setup finished. Next steps:"
            echo "  vmvpn vpn-connect      Connect to the VPN"
            echo "  vmvpn firefox          Browse through the VPN"
            echo "  vmvpn vpn-disconnect   Disconnect"
            ;;
    esac
}

# True when nothing is listening on local TCP port $1.
_port_is_free() {
    python3 - "$1" >/dev/null 2>&1 <<'EOF'
import socket, sys
s = socket.socket()
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
EOF
}

read_proxy_config() {
    check_jq
    check_vpn_config
    if ! jq -e 'type == "object"' "$VPN_CONFIG" >/dev/null 2>&1; then
        echo "Error: VPN config file is not valid JSON: $VPN_CONFIG" >&2
        exit 5
    fi

    # Proxy settings from config
    SOCKS_PROXY_ENABLED=$(jq -r '.socks_proxy.enabled // true' "$VPN_CONFIG")
    SOCKS_PROXY_PORT=$(jq -r '.socks_proxy.port // 1080' "$VPN_CONFIG")
    SOCKS_PROXY_AUTO_START=$(jq -r '.socks_proxy.auto_start // true' "$VPN_CONFIG")
    SOCKS_PROXY_AUTO_STOP=$(jq -r '.socks_proxy.auto_stop // true' "$VPN_CONFIG")
    HTTP_PROXY_ENABLED=$(jq -r '.http_proxy.enabled // false' "$VPN_CONFIG")
    HTTP_PROXY_PORT=$(jq -r '.http_proxy.port // 3128' "$VPN_CONFIG")
    HTTP_PROXY_AUTO_START=$(jq -r '.http_proxy.auto_start // false' "$VPN_CONFIG")
    HTTP_PROXY_AUTO_STOP=$(jq -r '.http_proxy.auto_stop // false' "$VPN_CONFIG")
}

read_vpn_config() {
    read_proxy_config

    VPN_GATEWAY=$(jq -r '.gateway' "$VPN_CONFIG")
    VPN_PORT=$(jq -r '.port // 443' "$VPN_CONFIG")
    VPN_USERNAME=$(jq -r '.username' "$VPN_CONFIG")
    VPN_PASSWORD=$(jq -r '.password // empty' "$VPN_CONFIG")

    if [[ -z "$VPN_GATEWAY" || "$VPN_GATEWAY" == "null" ]]; then
        echo "Error: 'gateway' is required in $VPN_CONFIG" >&2
        exit 5
    fi
    if [[ -z "$VPN_USERNAME" || "$VPN_USERNAME" == "null" ]]; then
        echo "Error: 'username' is required in $VPN_CONFIG" >&2
        exit 5
    fi
    if _is_example_placeholder "$VPN_GATEWAY" \
       || _is_example_placeholder "$VPN_USERNAME"; then
        echo "Error: the VPN config still has the example placeholder values: $VPN_CONFIG" >&2
        echo "Run 'vmvpn setup' to enter your real VPN account." >&2
        exit 5
    fi
}

# Escape a string for safe interpolation inside a double-quoted Tcl string.
tcl_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//\$/\\$}"
    s="${s//\[/\\[}"
    s="${s//\]/\\]}"
    printf '%s' "$s"
}

# Resolve VPN_PASSWORD for non-interactive-friendly connection.
# Order: --password-stdin > config "password" > GNOME keyring > tty prompt.
resolve_vpn_password() {
    if [[ "$VPN_PASSWORD_STDIN" == "true" ]]; then
        local stdin_password=""
        IFS= read -r stdin_password || true
        if [[ -n "$stdin_password" ]]; then
            VPN_PASSWORD="$stdin_password"
            return 0
        fi
    fi

    if [[ -n "$VPN_PASSWORD" ]]; then
        return 0
    fi

    if command -v secret-tool >/dev/null 2>&1; then
        VPN_PASSWORD=$(timeout 10 secret-tool lookup service vmvpn gateway "$VPN_GATEWAY" username "$VPN_USERNAME" 2>/dev/null || true)
        if [[ -n "$VPN_PASSWORD" ]]; then
            return 0
        fi
    fi

    if [[ -t 0 ]]; then
        read -rs -p "VPN Password for $VPN_USERNAME: " VPN_PASSWORD
        echo ""
        if [[ -z "$VPN_PASSWORD" ]]; then
            echo "Error: Password cannot be empty" >&2
            exit 1
        fi
        return 0
    fi

    echo "VMVPN_PASSWORD_REQUIRED" >&2
    exit 4
}

check_certificate_fingerprint() {
    local new_fingerprint="$1"
    local trust_fingerprint="${2:-}"
    local saved_fingerprint=""

    if [[ -f "$CERT_FINGERPRINT_FILE" ]]; then
        saved_fingerprint=$(cat "$CERT_FINGERPRINT_FILE")
    fi

    if [[ -n "$saved_fingerprint" && "$saved_fingerprint" == "$new_fingerprint" ]]; then
        echo "Certificate fingerprint verified."
        return 0
    fi

    if [[ -n "$trust_fingerprint" && "$trust_fingerprint" == "$new_fingerprint" ]]; then
        echo "$new_fingerprint" > "$CERT_FINGERPRINT_FILE"
        echo "Certificate fingerprint saved (trusted via --trust-fingerprint)."
        return 0
    fi

    if [[ ! -t 0 ]]; then
        echo "VMVPN_CERT_UNTRUSTED new=${new_fingerprint} saved=${saved_fingerprint}"
        echo "Error: VPN server certificate is not trusted." >&2
        echo "  Presented fingerprint: $new_fingerprint" >&2
        if [[ -n "$saved_fingerprint" ]]; then
            echo "  Saved fingerprint differs - this could indicate a MITM attack or a certificate update." >&2
        else
            echo "  No fingerprint saved yet." >&2
        fi
        echo "  To trust it, re-run interactively or pass: --trust-fingerprint $new_fingerprint" >&2
        return 3
    fi

    if [[ -z "$saved_fingerprint" ]]; then
        echo ""
        echo "New VPN server certificate detected:"
        echo "  Fingerprint (SHA1): $new_fingerprint"
        echo ""
        read -r -p "Trust this certificate and save fingerprint? (y/n) [n]: " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo "$new_fingerprint" > "$CERT_FINGERPRINT_FILE"
            echo "Certificate fingerprint saved."
            return 0
        else
            echo "Certificate rejected. Aborting connection."
            return 1
        fi
    else
        echo ""
        echo "WARNING: VPN server certificate has CHANGED!"
        echo "  Saved fingerprint:  $saved_fingerprint"
        echo "  New fingerprint:    $new_fingerprint"
        echo ""
        echo "This could indicate a man-in-the-middle attack or a legitimate certificate update."
        read -r -p "Accept the new certificate? (y/n) [n]: " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo "$new_fingerprint" > "$CERT_FINGERPRINT_FILE"
            echo "New certificate fingerprint saved."
            return 0
        else
            echo "Certificate rejected. Aborting connection."
            return 1
        fi
    fi
}

ensure_vm_running() {
    check_lima

    # Check if VM exists and is running
    if ! limactl list -q 2>/dev/null | grep -q "^${VM_NAME}$"; then
        phase "Creating the VM (first time only: downloads Ubuntu and installs FortiClient, usually 5–15 minutes)…"
        create_vm
        phase "Waiting for the VM to become ready…"
    elif ! limactl list 2>/dev/null | grep "^${VM_NAME}" | grep -q "Running"; then
        phase "Starting the VM…"
        limactl start --timeout="$START_TIMEOUT" "$VM_NAME"
    fi
    apply_guest_swap || echo "Warning: could not apply guest swap settings." >&2
}

vpn_connect() {
    VPN_PASSWORD_STDIN=false
    local trust_fingerprint=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --password-stdin)
                VPN_PASSWORD_STDIN=true
                ;;
            --trust-fingerprint)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --trust-fingerprint requires a fingerprint argument" >&2
                    exit 1
                fi
                trust_fingerprint="$2"
                shift
                ;;
            *)
                echo "Error: unknown option for vpn-connect: $1" >&2
                exit 1
                ;;
        esac
        shift
    done

    phase "Checking prerequisites…"
    read_vpn_config
    resolve_vpn_password
    ensure_vm_running

    local esc_gateway esc_port esc_username esc_password
    esc_gateway=$(tcl_escape "$VPN_GATEWAY")
    esc_port=$(tcl_escape "$VPN_PORT")
    esc_username=$(tcl_escape "$VPN_USERNAME")
    esc_password=$(tcl_escape "$VPN_PASSWORD")

    echo "Connecting to VPN: $VPN_GATEWAY:$VPN_PORT as $VPN_USERNAME..."

    # Ensure gnome-keyring-daemon is running (provides org.freedesktop.secrets for FortiClient)
    limactl shell "$VM_NAME" -- bash -c '
        if ! pgrep -u $USER gnome-keyring-d > /dev/null 2>&1; then
            eval $(dbus-launch --sh-syntax 2>/dev/null) || true
            echo "" | gnome-keyring-daemon --unlock --components=secrets 2>/dev/null || true
        fi
    ' 2>/dev/null || true

    # Create/update VPN profile using expect (VPN-only version doesn't have import command)
    local edit_script="
set timeout 30
spawn /opt/forticlient/forticlient-cli vpn edit vpn-tunnel
expect {
    \"Remote Gateway:\" {
        send -- \"${esc_gateway}:${esc_port}\r\"
        exp_continue
    }
    \"Authentication\" {
        send -- \"1\r\"
        exp_continue
    }
    \"Certificate Type\" {
        send -- \"3\r\"
        exp_continue
    }
    eof
}
"
    phase "Configuring the VPN profile in the guest…"
    echo "$edit_script" | limactl shell "$VM_NAME" -- expect -f - >/dev/null 2>&1

    # Fingerprints that can be accepted in the first attempt, avoiding a
    # disconnect/reconnect cycle that FortiClient may reject as "already running"
    local saved_fp="" esc_trusted
    [[ -f "$CERT_FINGERPRINT_FILE" ]] && saved_fp=$(cat "$CERT_FINGERPRINT_FILE")
    esc_trusted=$(tcl_escape "$saved_fp $trust_fingerprint")

    # First attempt to connect and capture certificate info
    local connect_output
    local connect_script="
set timeout 60
log_user 1
set trusted \"${esc_trusted}\"
spawn /opt/forticlient/forticlient-cli vpn connect vpn-tunnel --user=${esc_username} -p
expect {
    \"Password:\" {
        send -- \"${esc_password}\r\"
        exp_continue
    }
    \"Please input password\" {
        send -- \"${esc_password}\r\"
        exp_continue
    }
    -re \"Fingerprint \\\\(SHA1\\\\): (\[0-9A-Fa-f:\]+)\" {
        set fingerprint \$expect_out(1,string)
        puts \"CERT_FINGERPRINT::\$fingerprint\"
        exp_continue
    }
    \"Confirm (y/n)\" {
        if {[info exists fingerprint] && [lsearch -exact \$trusted \$fingerprint] >= 0} {
            puts \"CERT_ACCEPTED::\"
            send -- \"y\r\"
            exp_continue
        }
        send -- \"n\r\"
    }
    eof
}
"
    phase "Connecting to $VPN_GATEWAY:$VPN_PORT…"
    connect_output=$(echo "$connect_script" | limactl shell "$VM_NAME" -- expect -f - 2>&1)

    # Extract fingerprint from output
    local cert_fingerprint
    cert_fingerprint=$(echo "$connect_output" | grep -oP 'CERT_FINGERPRINT::\K[0-9A-Fa-f:]+' || true)

    if [[ -n "$cert_fingerprint" ]]; then
        # Certificate confirmation was requested - verify fingerprint
        local cert_rc=0
        check_certificate_fingerprint "$cert_fingerprint" "$trust_fingerprint" || cert_rc=$?
        if [[ $cert_rc -ne 0 ]]; then
            # Disconnect the stuck connection from the first attempt before giving up
            limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn disconnect 2>/dev/null || true
            exit "$cert_rc"
        fi

    fi

    if [[ -n "$cert_fingerprint" ]] && ! grep -q 'CERT_ACCEPTED::' <<<"$connect_output"; then
        # Disconnect the stuck connection from first attempt before reconnecting
        limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn disconnect >/dev/null 2>&1 || true

        # Wait until the tunnel is actually down (up to 15 seconds)
        local max_wait=15
        local waited=0
        while (( waited < max_wait )); do
            local status_check
            status_check=$(limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn status 2>&1 || true)
            if ! echo "$status_check" | grep -qi "Status: Connected\|tunnel.*active"; then
                break
            fi
            sleep 1
            waited=$((waited + 1))
        done

        # Reconnect and accept the certificate
        local reconnect_script="
set timeout 60
spawn /opt/forticlient/forticlient-cli vpn connect vpn-tunnel --user=${esc_username} -p
expect {
    \"Password:\" {
        send -- \"${esc_password}\r\"
        exp_continue
    }
    \"Please input password\" {
        send -- \"${esc_password}\r\"
        exp_continue
    }
    \"Confirm (y/n)\" {
        send -- \"y\r\"
        exp_continue
    }
    eof
}
"
        # FortiClient can still report the cancelled session as running for a while
        local attempt
        for attempt in 1 2 3 4 5; do
            connect_output=$(echo "$reconnect_script" | limactl shell "$VM_NAME" -- expect -f - 2>&1)
            grep -q "already running" <<<"$connect_output" || break
            sleep 3
        done
    fi
    sed -E 's/CERT_(FINGERPRINT::[0-9A-Fa-f:]*|ACCEPTED::)//' <<<"$connect_output"

    # Translate FortiClient's raw network errors into one readable line.
    if echo "$connect_output" | grep -qiE \
        "can ?not connect to vpn server|unable to resolve|could not resolve|name resolution|host is unreachable|no route to host|network is unreachable|timed out|connection refused"; then
        echo ""
        echo "Could not reach the VPN server $VPN_GATEWAY:$VPN_PORT. Check the address and your internet connection."
    fi

    # Check if login failed
    if echo "$connect_output" | grep -q "Login failed"; then
        echo ""
        echo "ERROR: VPN login failed. Please check your credentials."
        exit 2
    fi

    # Verify VPN is actually connected
    sleep 2
    local vpn_status
    vpn_status=$(limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn status 2>&1 || true)

    if ! echo "$vpn_status" | grep -q "Status: Connected"; then
        echo ""
        echo "ERROR: VPN connection failed."
        echo "$vpn_status"
        exit 1
    fi

    # Start proxies if configured
    start_proxies

    echo ""
    phase "Connected."
    echo "VPN connected."
    if [[ "$SOCKS_PROXY_ENABLED" == "true" ]]; then
        echo "  SOCKS5 proxy: localhost:$SOCKS_PROXY_PORT"
    fi
    if [[ "$HTTP_PROXY_ENABLED" == "true" ]]; then
        echo "  HTTP proxy:   localhost:$HTTP_PROXY_PORT"
    fi
}

vpn_disconnect() {
    read_proxy_config
    check_lima
    
    # Stop proxies
    echo "Stopping proxies..."
    stop_proxies
    
    echo "Disconnecting from VPN..."
    limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn disconnect 2>/dev/null || true
    echo "VPN disconnected."
}

vpn_status() {
    read_proxy_config
    check_lima

    echo "VPN:"
    limactl shell "$VM_NAME" -- timeout -k 5 30 /opt/forticlient/forticlient-cli vpn status 2>/dev/null | sed 's/^/  /' || echo "  Not connected"

    show_proxy_status
}

check_secret_tool() {
    if ! command -v secret-tool >/dev/null 2>&1; then
        echo "Error: secret-tool not found (required for keyring storage)." >&2
        echo "Install it with: sudo apt install libsecret-tools" >&2
        exit 1
    fi
}

password_set() {
    local use_stdin=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --stdin) use_stdin=true ;;
            *) echo "Error: unknown option for password-set: $1" >&2; exit 1 ;;
        esac
        shift
    done

    read_vpn_config
    check_secret_tool

    local pw=""
    if [[ "$use_stdin" == "true" ]]; then
        IFS= read -r pw || true
    elif [[ -t 0 ]]; then
        read -rs -p "VPN Password for $VPN_USERNAME: " pw
        echo ""
    else
        echo "VMVPN_PASSWORD_REQUIRED" >&2
        exit 4
    fi

    if [[ -z "$pw" ]]; then
        echo "Error: Password cannot be empty" >&2
        exit 1
    fi

    if ! printf '%s' "$pw" | timeout 120 secret-tool store --label="vmvpn: $VPN_USERNAME@$VPN_GATEWAY" \
        service vmvpn gateway "$VPN_GATEWAY" username "$VPN_USERNAME"; then
        echo "Error: failed to store the password in GNOME keyring." >&2
        exit 1
    fi
    local stored
    stored=$(timeout 10 secret-tool lookup service vmvpn gateway "$VPN_GATEWAY" username "$VPN_USERNAME" 2>/dev/null || true)
    if [[ "$stored" != "$pw" ]]; then
        echo "Error: keyring verification failed; the stored password could not be read back." >&2
        exit 1
    fi
    echo "Password stored in GNOME keyring for $VPN_USERNAME@$VPN_GATEWAY."
}

password_clear() {
    read_vpn_config
    check_secret_tool

    if secret-tool clear service vmvpn gateway "$VPN_GATEWAY" username "$VPN_USERNAME" 2>/dev/null; then
        echo "Stored password removed from GNOME keyring for $VPN_USERNAME@$VPN_GATEWAY."
    else
        echo "No stored password found for $VPN_USERNAME@$VPN_GATEWAY."
    fi
}

cert_forget() {
    if [[ -f "$CERT_FINGERPRINT_FILE" ]]; then
        rm -f "$CERT_FINGERPRINT_FILE"
        echo "Saved certificate fingerprint removed: $CERT_FINGERPRINT_FILE"
    else
        echo "No saved certificate fingerprint ($CERT_FINGERPRINT_FILE)."
    fi
}

# Launch the GUI settings window, detached.
# -- UI (tray + window processes) ----------------------------------------------
# From the user's point of view the UI is a single component managed through
# `vmvpn`; vmvpn-tray / vmvpn-window are internal details. Preferences live in
# ui.json; autostart entries and starting/stopping the processes are handled
# here only — the GUI calls back into these commands.
UI_PREFS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/vmvpn/ui.json"
UI_LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/vmvpn/ui.log"
TRAY_AUTOSTART_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/vmvpn-tray.desktop"
VM_AUTOSTART_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/vmvpn-vm.desktop"
UI_TRAY_BUS="io.github.carrerfe.VmVpn.Tray"
UI_TRAY_OBJECT="/io/github/carrerfe/VmVpn/Tray"
UI_WINDOW_BUS="io.github.carrerfe.VmVpn"
UI_WINDOW_OBJECT="/io/github/carrerfe/VmVpn"

# ui_pref_get <key> <default> → 0 when the pref is on. A missing file or key
# means the default.
ui_pref_get() {
    local key="$1" default="$2" val=""
    if [[ -f "$UI_PREFS_FILE" ]] && command -v jq >/dev/null 2>&1; then
        val=$(jq -r --arg k "$key" \
            'if (.[$k] | type) == "boolean" then .[$k] else "UNSET" end' \
            "$UI_PREFS_FILE" 2>/dev/null || true)
    fi
    case "$val" in
        true)  return 0 ;;
        false) return 1 ;;
        *)     [[ "$default" == "true" ]] ;;
    esac
}

# ui_pref_set <key> <true|false> — preserves unknown keys in ui.json.
ui_pref_set() {
    local key="$1" value="$2"
    mkdir -p "$(dirname "$UI_PREFS_FILE")"
    local tmp
    tmp=$(mktemp) || return 1
    if [[ -f "$UI_PREFS_FILE" ]] \
       && jq -e 'type == "object"' "$UI_PREFS_FILE" >/dev/null 2>&1; then
        jq --arg k "$key" --argjson v "$value" \
            '.[$k] = $v' "$UI_PREFS_FILE" > "$tmp"
    else
        jq -n --arg k "$key" --argjson v "$value" '{($k): $v}' > "$tmp"
    fi \
        || { rm -f "$tmp"; echo "Error: could not write $UI_PREFS_FILE" >&2; return 1; }
    mv "$tmp" "$UI_PREFS_FILE"
}

ui_has_display() {
    [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]]
}

# 0 when the GApplication name $1 is owned on the session bus. Falls back to
# pgrep on the script path when gdbus is unavailable.
ui_process_running() {
    local name="$1"
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest org.freedesktop.DBus \
            --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.NameHasOwner "$name" 2>/dev/null \
            | grep -q "true" && return 0
        return 1
    fi
    local gui_dir
    gui_dir=$(ui_gui_dir 2>/dev/null) || return 1
    case "$name" in
        "$UI_TRAY_BUS")   pgrep -f "$gui_dir/vmvpn-tray" >/dev/null ;;
        "$UI_WINDOW_BUS") pgrep -f "$gui_dir/vmvpn-window" >/dev/null ;;
        *)                return 1 ;;
    esac
}

# Spawn a GUI script detached: own session, stdin closed, output to ui.log.
ui_spawn() {
    local script="$1"; shift
    local gui_dir
    gui_dir=$(ui_gui_dir) || {
        echo "Error: the VM VPN app is not installed (no vmvpn-gui/ next to vmvpn)." >&2
        return 1
    }
    mkdir -p "$(dirname "$UI_LOG_FILE")"
    setsid "$gui_dir/$script" "$@" </dev/null >>"$UI_LOG_FILE" 2>&1 &
    disown 2>/dev/null || true
}

# Quit a running GApplication via its 'quit' action; TERM the script path
# when the D-Bus call does not reach it.
ui_stop_process() {
    local bus="$1" object="$2" script="$3" i
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest "$bus" --object-path "$object" \
            --method org.freedesktop.Application.ActivateAction \
            "quit" "@av []" "{}" >/dev/null 2>&1 || true
        i=0
        while ui_process_running "$bus" && (( i < 20 )); do
            sleep 0.1
            i=$((i + 1))
        done
    fi
    if ui_process_running "$bus"; then
        local gui_dir
        gui_dir=$(ui_gui_dir 2>/dev/null) \
            && pkill -f "$gui_dir/$script" 2>/dev/null || true
    fi
    return 0
}

# Quote an Exec value per the Desktop Entry spec: wrap in double quotes,
# backslash-escape " ` $ \
desktop_exec_quote() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//\`/\\\`}"
    value="${value//\$/\\\$}"
    printf '"%s"' "$value"
}

# The tray autostart entry runs 'vmvpn ui --login': a single launch path that
# respects the ui.json preferences.
ui_write_tray_autostart() {
    mkdir -p "$(dirname "$TRAY_AUTOSTART_FILE")"
    cat > "$TRAY_AUTOSTART_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=VM VPN Tray
Exec=$(desktop_exec_quote "$SCRIPT_DIR/vmvpn") ui --login
Icon=network-vpn
X-GNOME-Autostart-enabled=true
EOF
}

# Automatic autostart maintenance only happens from the installed layout
# ($SCRIPT_DIR/vmvpn-gui/): a checkout must never touch the user's login
# entries, and `vmvpn ui` from a checkout must not hijack them either.
ui_migrate_tray_autostart() {
    [[ -d "$SCRIPT_DIR/vmvpn-gui" ]] || return 0
    if [[ ! -f "$TRAY_AUTOSTART_FILE" ]]; then
        # Create the entry when the tray is enabled but none exists (e.g.
        # after a headless install).
        ui_pref_get tray true && ui_write_tray_autostart
        return 0
    fi
    grep -q "ui --login" "$TRAY_AUTOSTART_FILE" && return 0
    # Rewrite only a pre-1.1 entry that launched *this* install's vmvpn-tray;
    # entries pointing at other installs are left alone.
    grep -qF "$SCRIPT_DIR" "$TRAY_AUTOSTART_FILE" || return 0
    grep -q "vmvpn-tray" "$TRAY_AUTOSTART_FILE" || return 0
    ui_write_tray_autostart
    echo "Migrated the tray autostart entry to 'vmvpn ui --login'."
}

# vmvpn ui [status|logs|settings|setup]: start the tray when enabled, then
# open or present the window on the page. Returns immediately.
ui_open() {
    local page="${1:-status}"
    if ! ui_has_display; then
        echo "Error: no graphical session (DISPLAY/WAYLAND_DISPLAY unset)." >&2
        echo "The VM VPN app needs a desktop session; the vmvpn CLI works" >&2
        echo "without one." >&2
        exit 1
    fi
    ui_migrate_tray_autostart
    if ui_pref_get tray true && ! ui_process_running "$UI_TRAY_BUS"; then
        ui_spawn vmvpn-tray
    fi
    ui_spawn vmvpn-window --page "$page"
}

# Autostart entry point: tray if enabled; the setup assistant when there is
# no usable VPN config and the prompt is still on.
ui_login() {
    ui_has_display || return 0
    ui_migrate_tray_autostart
    if ui_pref_get tray true && ! ui_process_running "$UI_TRAY_BUS"; then
        ui_spawn vmvpn-tray
    fi
    if ! vpn_config_usable && ui_pref_get setup_prompt true; then
        ui_spawn vmvpn-window --page setup
    fi
    return 0
}

ui_stop() {
    ui_stop_process "$UI_WINDOW_BUS" "$UI_WINDOW_OBJECT" vmvpn-window
    ui_stop_process "$UI_TRAY_BUS" "$UI_TRAY_OBJECT" vmvpn-tray
    echo "VM VPN app stopped."
}

ui_tray() {
    case "${1:-}" in
        on)
            ui_pref_set tray true
            ui_write_tray_autostart
            if ! ui_process_running "$UI_TRAY_BUS" && ui_has_display; then
                ui_spawn vmvpn-tray
            fi
            echo "Tray icon: enabled."
            echo "Autostart entry: $TRAY_AUTOSTART_FILE"
            ;;
        off)
            ui_pref_set tray false
            if [[ -f "$TRAY_AUTOSTART_FILE" ]]; then
                rm -f "$TRAY_AUTOSTART_FILE"
                echo "Removed autostart entry: $TRAY_AUTOSTART_FILE"
            fi
            ui_stop_process "$UI_TRAY_BUS" "$UI_TRAY_OBJECT" vmvpn-tray
            echo "Tray icon: disabled."
            ;;
        "")
            local state="disabled" running="not running"
            ui_pref_get tray true && state="enabled"
            ui_process_running "$UI_TRAY_BUS" && running="running"
            echo "Tray icon: $state ($running)"
            ;;
        *)
            echo "Usage: vmvpn ui tray [on|off]" >&2
            exit 1
            ;;
    esac
}

ui_setup_prompt() {
    case "${1:-}" in
        on|off)
            local json=true
            [[ "$1" == off ]] && json=false
            ui_pref_set setup_prompt "$json" && echo "Setup prompt: $1."
            ;;
        "")
            if ui_pref_get setup_prompt true; then
                echo "Setup prompt: enabled"
            else
                echo "Setup prompt: disabled"
            fi
            ;;
        *)
            echo "Usage: vmvpn ui setup-prompt [on|off]" >&2
            exit 1
            ;;
    esac
}

ui() {
    ui_migrate_tray_autostart
    case "${1:-status}" in
        --login)        ui_login ;;
        stop)           ui_stop ;;
        tray)           ui_tray "${2:-}" ;;
        setup-prompt)   ui_setup_prompt "${2:-}" ;;
        status|logs|settings|setup) ui_open "$1" ;;
        "")             ui_open status ;;
        *)
            echo "Error: unknown 'ui' subcommand: $1" >&2
            echo "Usage: vmvpn ui [status|logs|settings|setup|stop|tray|setup-prompt]" >&2
            exit 1
            ;;
    esac
}

# -- VM autostart (start the VM at graphical login) ----------------------------

vm_autostart() {
    case "${1:-}" in
        on)
            if ! command -v limactl >/dev/null 2>&1 \
               || ! limactl list -q 2>/dev/null | grep -qx "$VM_NAME"; then
                echo "Error: the VM '$VM_NAME' does not exist." >&2
                echo "Create the VM first: vmvpn setup, or vmvpn start." >&2
                exit 1
            fi
            mkdir -p "$(dirname "$VM_AUTOSTART_FILE")"
            cat > "$VM_AUTOSTART_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=VM VPN virtual machine
Exec=$(desktop_exec_quote "$SCRIPT_DIR/vmvpn") vm-autostart run
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=10
EOF
            echo "VM autostart enabled — '$VM_NAME' starts at login."
            echo "Autostart entry: $VM_AUTOSTART_FILE"
            ;;
        off)
            if [[ -f "$VM_AUTOSTART_FILE" ]]; then
                rm -f "$VM_AUTOSTART_FILE"
                echo "Removed autostart entry: $VM_AUTOSTART_FILE"
            fi
            echo "VM autostart disabled."
            ;;
        run)
            vm_autostart_run
            ;;
        "")
            if [[ -f "$VM_AUTOSTART_FILE" ]]; then
                echo "VM autostart: enabled"
            else
                echo "VM autostart: disabled"
            fi
            ;;
        *)
            echo "Usage: vmvpn vm-autostart [on|off|run]" >&2
            exit 1
            ;;
    esac
}

# Runs at login (autostart entry): start the VM when it exists and is
# stopped. Never creates a VM; exits 0 when there is nothing to do.
vm_autostart_run() {
    local log="${XDG_STATE_HOME:-$HOME/.local/state}/vmvpn/vm-autostart.log"
    mkdir -p "$(dirname "$log")"
    command -v limactl >/dev/null 2>&1 || exit 0
    limactl list -q 2>/dev/null | grep -qx "$VM_NAME" || exit 0
    limactl list 2>/dev/null \
        | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { f=1 } END { exit !f }' \
        && exit 0
    {
        echo "=== $(date '+%F %T') starting '$VM_NAME' at login ==="
        run_locked start
    } >> "$log" 2>&1
}


logs() {
    local source="${1:-}"
    local lines=200 follow=false
    if [[ $# -gt 0 ]]; then
        shift
    fi
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n)
                if [[ $# -lt 2 || ! "$2" =~ ^[0-9]+$ ]]; then
                    echo "Error: -n requires a number of lines" >&2
                    exit 1
                fi
                lines="$2"
                shift 2
                ;;
            -f|--follow)
                follow=true
                shift
                ;;
            *)
                echo "Error: unknown option for logs: $1" >&2
                exit 1
                ;;
        esac
    done

    case "$source" in
        journal|squid|forticlient|vpn) ;;
        ""|-h|--help)
            echo "Usage: vmvpn logs {vpn|journal|squid|forticlient} [-n N] [-f]" >&2
            exit 1
            ;;
        *)
            echo "Error: unknown option for logs: $source" >&2
            echo "Sources: vpn, journal, squid, forticlient" >&2
            exit 1
            ;;
    esac

    check_lima
    if ! limactl list 2>/dev/null | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { found=1 } END { exit !found }'; then
        echo "Error: VM '$VM_NAME' is not running." >&2
        exit 1
    fi

    if [[ "$follow" == "true" ]]; then
        # Wrap the remote follower in sh: when the local process dies, stdin
        # reaches EOF, `cat` exits and the remote tail/journalctl is killed —
        # no orphaned followers left in the guest.
        local remote_cmd
        case "$source" in
            journal)
                remote_cmd="journalctl -f -n $lines --no-pager" ;;
            squid)
                remote_cmd="tail -n $lines -F /var/log/squid/cache.log /var/log/squid/access.log" ;;
            forticlient)
                remote_cmd="tail -n $lines -F /var/log/forticlient/sslvpn.log /var/log/forticlient/firewall.log /var/log/forticlient/confighandler.log /var/log/forticlient/fctsched.log" ;;
            vpn)
                remote_cmd="tail -n $lines -F /var/log/forticlient/sslvpn.log /var/log/forticlient/fctsched.log" ;;
        esac
        limactl shell "$VM_NAME" -- sudo sh -c \
            "$remote_cmd & p=\$!; cat >/dev/null; kill \$p 2>/dev/null; wait \$p 2>/dev/null"
        return
    fi

    case "$source" in
        journal)
            limactl shell "$VM_NAME" -- sudo journalctl -n "$lines" --no-pager
            ;;
        squid)
            limactl shell "$VM_NAME" -- sudo bash -c '
                for f in /var/log/squid/cache.log /var/log/squid/access.log; do
                    echo "=== $f ==="
                    tail -n '"$lines"' "$f" 2>/dev/null || echo "(missing)"
                    echo
                done
            '
            ;;
        forticlient)
            limactl shell "$VM_NAME" -- sudo bash -c '
                for f in /var/log/forticlient/sslvpn.log \
                         /var/log/forticlient/firewall.log \
                         /var/log/forticlient/confighandler.log \
                         /var/log/forticlient/fctsched.log; do
                    echo "=== $f ==="
                    tail -n '"$lines"' "$f" 2>/dev/null || echo "(missing)"
                    echo
                done
            '
            ;;
        vpn)
            limactl shell "$VM_NAME" -- sudo bash -c '
                for f in /var/log/forticlient/sslvpn.log \
                         /var/log/forticlient/fctsched.log; do
                    echo "=== $f ==="
                    tail -n '"$lines"' "$f" 2>/dev/null || echo "(missing)"
                    echo
                done
            '
            ;;
    esac
}

start_socks_proxy() {
    local port="$1"
    
    # Check if SOCKS proxy is already running
    if pgrep -f "ssh.*-D.*127.0.0.1:$port.*lima-$VM_NAME" > /dev/null 2>&1; then
        return 0
    fi
    
    local ssh_config="$HOME/.lima/$VM_NAME/ssh.config"
    ssh -F "$ssh_config" -D "127.0.0.1:$port" -N -f lima-$VM_NAME 2>/dev/null
}

stop_socks_proxy() {
    local port="$1"
    pkill -f "ssh.*-D.*127.0.0.1:$port.*lima-$VM_NAME" 2>/dev/null || true
}

start_proxies() {
    if [[ "$SOCKS_PROXY_ENABLED" == "true" && "$SOCKS_PROXY_AUTO_START" == "true" ]]; then
        phase "Starting the SOCKS proxy on localhost:$SOCKS_PROXY_PORT…"
        start_socks_proxy "$SOCKS_PROXY_PORT"
    fi
    
    # HTTP proxy (Squid) is already running in the VM, just report if enabled and auto_start
    if [[ "$HTTP_PROXY_ENABLED" == "true" && "$HTTP_PROXY_AUTO_START" == "true" ]]; then
        echo "HTTP proxy available on localhost:$HTTP_PROXY_PORT"
    fi
}

stop_proxies() {
    if [[ "$SOCKS_PROXY_ENABLED" == "true" && "$SOCKS_PROXY_AUTO_STOP" == "true" ]]; then
        stop_socks_proxy "$SOCKS_PROXY_PORT"
    fi
}

show_proxy_status() {
    echo ""
    echo "Proxy status:"
    
    if [[ "$SOCKS_PROXY_ENABLED" == "true" ]]; then
        if pgrep -f "ssh.*-D.*127.0.0.1:$SOCKS_PROXY_PORT.*lima-$VM_NAME" > /dev/null 2>&1; then
            echo "  SOCKS5 proxy: running on localhost:$SOCKS_PROXY_PORT"
        else
            echo "  SOCKS5 proxy: not running (configured on port $SOCKS_PROXY_PORT)"
        fi
    else
        echo "  SOCKS5 proxy: disabled"
    fi
    
    if [[ "$HTTP_PROXY_ENABLED" == "true" ]]; then
        echo "  HTTP proxy:   available on localhost:$HTTP_PROXY_PORT"
    else
        echo "  HTTP proxy:   disabled"
    fi
}

get_firefox_profile_path() {
    local profiles_dir="$HOME/.mozilla/firefox"
    # Snap Firefox stores profiles under ~/snap/firefox/common/.mozilla/firefox
    local snap_profiles_dir="$HOME/snap/firefox/common/.mozilla/firefox"

    local search_dirs=()
    [[ -d "$profiles_dir" ]] && search_dirs+=("$profiles_dir")
    [[ -d "$snap_profiles_dir" ]] && search_dirs+=("$snap_profiles_dir")

    if [[ ${#search_dirs[@]} -eq 0 ]]; then
        return 0
    fi

    local pdir
    for pdir in "${search_dirs[@]}"; do
        local profile_ini="$pdir/profiles.ini"
        if [[ -f "$profile_ini" ]]; then
            local rel_path
            rel_path=$(awk -v name="$FIREFOX_PROFILE_NAME" '
                /^\[/ { if (found_name && path != "") { print path; exit } in_profile=0; path=""; found_name=0 }
                /^\[Profile/ { in_profile=1 }
                in_profile && /^Name=/ { sub(/^Name=/, ""); if ($0 == name) found_name=1 }
                in_profile && /^Path=/ { sub(/^Path=/, ""); path=$0 }
                END { if (found_name && path != "") print path }
            ' "$profile_ini")
            if [[ -n "$rel_path" ]]; then
                echo "$pdir/$rel_path"
                return 0
            fi
        fi

        # Fallback: look for directory ending with profile name
        local dir
        for dir in "$pdir"/*."$FIREFOX_PROFILE_NAME"; do
            if [[ -d "$dir" ]]; then
                echo "$dir"
                return 0
            fi
        done
    done
}

create_firefox_profile() {
    read_proxy_config
    
    # Check if Firefox is installed
    if ! command -v firefox &> /dev/null; then
        echo "Error: Firefox is not installed." >&2
        echo "Install it with your package manager, e.g.: sudo apt install firefox" >&2
        exit 1
    fi
    
    # Create profile if it doesn't exist
    local profile_path
    profile_path=$(get_firefox_profile_path)

    if [[ -z "$profile_path" || ! -d "$profile_path" ]]; then
        echo "Creating Firefox profile '$FIREFOX_PROFILE_NAME'..." >&2
        firefox -headless -CreateProfile "$FIREFOX_PROFILE_NAME" 2>&1 | sed 's/^/  /' >&2 || true
        sleep 1
        profile_path=$(get_firefox_profile_path)
    fi
    
    if [[ -z "$profile_path" || ! -d "$profile_path" ]]; then
        echo "Error: Could not find or create Firefox profile directory" >&2
        echo "Try creating it manually: firefox -CreateProfile $FIREFOX_PROFILE_NAME" >&2
        exit 1
    fi
    
    # Configure proxy settings in user.js
    local user_js="$profile_path/user.js"
    
    # Determine which proxy to use (prefer SOCKS if enabled)
    local proxy_type proxy_host proxy_port
    if [[ "$SOCKS_PROXY_ENABLED" == "true" ]]; then
        proxy_type=1  # Manual proxy
        proxy_host="127.0.0.1"
        proxy_port="$SOCKS_PROXY_PORT"
        cat > "$user_js" << EOF
// Ubuntu VPN Proxy Configuration (auto-generated)
user_pref("network.proxy.type", 1);
user_pref("network.proxy.socks", "$proxy_host");
user_pref("network.proxy.socks_port", $proxy_port);
user_pref("network.proxy.socks_version", 5);
user_pref("network.proxy.socks_remote_dns", true);
user_pref("network.proxy.no_proxies_on", "");
EOF
    elif [[ "$HTTP_PROXY_ENABLED" == "true" ]]; then
        proxy_host="127.0.0.1"
        proxy_port="$HTTP_PROXY_PORT"
        cat > "$user_js" << EOF
// Ubuntu VPN Proxy Configuration (auto-generated)
user_pref("network.proxy.type", 1);
user_pref("network.proxy.http", "$proxy_host");
user_pref("network.proxy.http_port", $proxy_port);
user_pref("network.proxy.ssl", "$proxy_host");
user_pref("network.proxy.ssl_port", $proxy_port);
user_pref("network.proxy.no_proxies_on", "");
EOF
    else
        echo "Warning: No proxy enabled in config. Firefox will use direct connection." >&2
        cat > "$user_js" << EOF
// Ubuntu VPN Proxy Configuration (auto-generated)
user_pref("network.proxy.type", 0);
EOF
    fi
    
    echo "$profile_path"
}

launch_firefox() {
    read_proxy_config
    check_lima

    # The VPN must be connected — otherwise every page would fail on a dead
    # proxy.
    local connected=false
    if limactl list 2>/dev/null \
       | awk -v n="$VM_NAME" '$1 == n && $2 == "Running" { f=1 } END { exit !f }' \
       && limactl shell "$VM_NAME" -- timeout -k 5 15 \
           /opt/forticlient/forticlient-cli vpn status 2>/dev/null \
           | grep -q "Status: Connected"; then
        connected=true
    fi

    if [[ "$connected" != "true" ]]; then
        if [[ -t 0 ]]; then
            local rsp=""
            read -r -p "The VPN is not connected. Connect now? [Y/n] " rsp
            if [[ -z "$rsp" || "$rsp" =~ ^[Yy] ]]; then
                run_locked vpn_connect || {
                    echo "Not launching Firefox." >&2
                    exit 1
                }
                limactl shell "$VM_NAME" -- timeout -k 5 15 \
                    /opt/forticlient/forticlient-cli vpn status 2>/dev/null \
                    | grep -q "Status: Connected" \
                    || { echo "Not launching Firefox." >&2; exit 1; }
            else
                echo "Not launching Firefox."
                return 0
            fi
        else
            echo "Error: the VPN is not connected. Run 'vmvpn vpn-connect' first." >&2
            exit 1
        fi
    fi

    # Make sure the SOCKS proxy is actually running before pointing Firefox
    # at it.
    if [[ "$SOCKS_PROXY_ENABLED" == "true" ]] \
       && ! pgrep -f "ssh.*-D.*127.0.0.1:$SOCKS_PROXY_PORT.*lima-$VM_NAME" >/dev/null 2>&1; then
        phase "Starting the SOCKS proxy on localhost:$SOCKS_PROXY_PORT…"
        start_socks_proxy "$SOCKS_PROXY_PORT"
    fi

    if ! command -v firefox >/dev/null 2>&1; then
        echo "Error: Firefox is not installed." >&2
        echo "Install it with your package manager, e.g.: sudo apt install firefox" >&2
        exit 1
    fi

    local profile_path
    profile_path=$(create_firefox_profile)
    
    echo "Launching Firefox with profile '$FIREFOX_PROFILE_NAME'..."
    if [[ "$SOCKS_PROXY_ENABLED" == "true" ]]; then
        echo "  Using SOCKS5 proxy: localhost:$SOCKS_PROXY_PORT"
    elif [[ "$HTTP_PROXY_ENABLED" == "true" ]]; then
        echo "  Using HTTP proxy: localhost:$HTTP_PROXY_PORT"
    fi
    
    # Launch Firefox with the profile (in background, detached)
    # Use --new-instance instead of -no-remote for better compatibility with Snap Firefox
    nohup firefox -P "$FIREFOX_PROFILE_NAME" --new-instance "$@" >/dev/null 2>&1 &
    disown
    
    # Brief wait to check if Firefox actually started
    sleep 1
    if ! pgrep -f "firefox.*$FIREFOX_PROFILE_NAME" > /dev/null 2>&1; then
        echo "Warning: Firefox may not have started. Try launching manually:" >&2
        echo "  firefox -P $FIREFOX_PROFILE_NAME --new-instance" >&2
    else
        echo "Firefox launched."
    fi
}

show_firefox_profile() {
    read_proxy_config
    
    local profile_path
    profile_path=$(get_firefox_profile_path)
    
    echo "Firefox VPN Profile"
    echo "==================="
    echo ""
    echo "Profile name: $FIREFOX_PROFILE_NAME"
    
    if [[ -n "$profile_path" && -d "$profile_path" ]]; then
        echo "Profile path: $profile_path"
        echo ""
        echo "Proxy configuration:"
        if [[ -f "$profile_path/user.js" ]]; then
            grep -E "network.proxy" "$profile_path/user.js" | sed 's/^/  /'
        else
            echo "  (no user.js found)"
        fi
    else
        echo "Profile path: (not created yet - run 'firefox' command first)"
    fi
    
    echo ""
    echo "To delete this profile, run:"
    echo "  firefox -P  # Opens profile manager, select '$FIREFOX_PROFILE_NAME' and click 'Delete Profile'"
    echo ""
    echo "Or manually delete:"
    if [[ -n "$profile_path" && -d "$profile_path" ]]; then
        echo "  rm -rf \"$profile_path\""
    else
        echo "  rm -rf ~/.mozilla/firefox/*.$FIREFOX_PROFILE_NAME"
    fi
}

