case "${1:-}" in
    version|--version|-V)
        line="vmvpn $VMVPN_VERSION"
        if rel=$(release_info); then
            line="$line ($rel)"
        fi
        echo "$line"
        ;;
    setup)
        setup
        ;;
    start)
        run_locked start
        ;;
    stop)
        stop "${@:2}"
        ;;
    restart)
        run_locked restart
        ;;
    abort)
        abort
        ;;
    settings)
        ui settings
        ;;
    ui)
        ui "${@:2}"
        ;;
    vm-autostart)
        vm_autostart "${@:2}"
        ;;
    shell)
        shell
        ;;
    ssh)
        ssh_connect
        ;;
    status)
        case "${2:-}" in
            --json) status_json ;;
            "") status ;;
            *) echo "Error: unknown option for status: $2" >&2; exit 1 ;;
        esac
        ;;
    delete)
        delete "${@:2}"
        ;;
    vm-apply)
        run_locked vm_apply "${@:2}"
        ;;
    logs)
        logs "${@:2}"
        ;;
    vpn-connect)
        run_locked vpn_connect "${@:2}"
        ;;
    vpn-disconnect)
