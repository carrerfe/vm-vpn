{
  "gateway": "vpn.example.com",
  "port": 443,
  "username": "your-username",
  "socks_proxy": {
    "enabled": true,
    "port": 1080,
    "auto_start": true,
    "auto_stop": true
  },
  "http_proxy": {
    "enabled": false,
    "port": 3128,
    "auto_start": false,
    "auto_stop": false
  },
  "vm": {
    "cpus": 2,
    "memory_mib": 512,
    "disk_gib": 20,
    "swap_mib": 0,
    "swappiness": null
  }
}
